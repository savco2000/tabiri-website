# Production deployments must provide all values below. Development uses
# Cloudflare's always-pass test keys when these variables are unset.
APP_ENV=production
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.tabirianalytics.com,tabirianalytics.com

# Generate with:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
FORM_HMAC_KEY=

# Optional. When unset, OpenTelemetry remains local and performs no exports.
# OTLP exporters also honor the standard OTEL_EXPORTER_OTLP_* variables.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Trace sampling ratio from 0.0 to 1.0. Production defaults to 0.1.
OTEL_TRACES_SAMPLER_ARG=0.1
