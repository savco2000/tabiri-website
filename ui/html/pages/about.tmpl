<!-- Core Values Section -->
<section class="py-12 bg-surface-container-low border-y border-outline-variant" id="values">
    <div class="max-w-7xl mx-auto px-gutter">
        <div class="text-center mb-10 md:mb-12">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-outline-variant bg-surface-container-lowest mb-4">
