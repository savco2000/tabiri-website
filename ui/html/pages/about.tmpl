{{define "main"}}
<!-- Hero Section -->
<section class="page-hero">
    <div class="hero-overlay"></div>
    <div class="hero-split">
        <div class="hero-split__copy">
            <div class="hero-kicker">
                <span class="material-symbols-outlined icon-size-sm">groups</span>
                <span class="eyebrow">About Tabiri Analytics</span>
            </div>
            <h1 class="hero-title">
                Built On <span>Zero-Trust Foundations</span>
            </h1>
            <p class="hero-description hero-description--compact">
                Tabiri Analytics emerged from deep research into sovereign systems, cybersecurity, and agentic automation at <span class="hero-description__emphasis">Carnegie Mellon University</span>. We build Digital Employees that operate with precision, accountability, and enterprise-grade trust.
            </p>
            <div class="hero-actions hero-actions--left">
                <a class="btn-primary" href="#leadership">Meet The Team</a>
                <a class="btn-secondary" href="#values">Our Principles</a>
            </div>
        </div>
        <div class="hero-split__visual">
            <div class="hero-split__glow"></div>
            <div class="hero-split__frame">
                <img alt="Engineers collaborating on secure AI workflows and sovereign edge infrastructure" class="hero-split__image" width="1024" height="1024" fetchpriority="high" decoding="async" src="/static/images/engineering_lab.avif">
            </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section class="content-section content-section--muted content-section--bordered">
    <div class="about-mission">
        <span class="section-kicker section-kicker--light">
            <span class="material-symbols-outlined icon-size-sm">track_changes</span>
            <span class="eyebrow">Mission</span>
        </span>
        <h2 class="section-heading">Empowering The Sovereign Node</h2>
        <p class="hero-description hero-description--centered">
            We bridge the gap between human intent and automated execution, ensuring that AI agents act with the same level of trust, security, and precision as your most valued colleague.
        </p>
    </div>
</section>

<!-- Leadership Section -->
<section class="content-section content-section--light" id="leadership">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <span class="section-kicker">
                <span class="material-symbols-outlined icon-size-sm">badge</span>
                <span class="eyebrow">Leadership</span>
            </span>
            <h2 class="section-heading">The Engineers Of <span>Secure Agentic Automation</span></h2>
            <p class="section-intro__description section-intro__description--wide">
                Our team combines distributed systems, secure infrastructure, AI orchestration, and enterprise growth expertise to build trustworthy automation at scale.
            </p>
        </div>

        <div class="feature-grid feature-grid--two-to-three">
            <!-- Edwin Kairu Card -->
            <article class="profile-card">
                <div class="profile-card__header">
                    <img alt="Edwin Kairu headshot" class="profile-card__avatar" loading="lazy" decoding="async" src="/static/images/edwin_kairu_headshot.avif">
                    <div>
                        <h3 class="heading-medium">Edwin Kairu</h3>
                        <p class="eyebrow eyebrow--primary">Co-Founder and CEO</p>
                    </div>
                </div>
                <p class="body-copy-small body-copy-small--spaced">Experienced cybersecurity professional and entrepreneur with a proven track record of strengthening the security posture of organizations across sectors.</p>
                <p class="body-copy-small body-copy-small--spaced">Edwin is a Distinguished Service Professor at Carnegie Mellon University and brings deep expertise in agentic SecOps.</p>
                <p class="body-copy-small body-copy-small--spaced">He holds a BSc in Management Information Systems from the State University of New York (SUNY) at Buffalo and an MSc in Information Security Policy and Management from Carnegie Mellon University.</p>
                <div class="profile-card__accent"></div>
            </article>

            <!-- Savannah Kadima Card -->
            <article class="profile-card">
                <div class="profile-card__header">
                    <img alt="Savannah Kadima headshot" class="profile-card__avatar" loading="lazy" decoding="async" src="/static/images/savannah_kadima_headshot.avif">
                    <div>
                        <h3 class="heading-medium">Savannah Kadima</h3>
                        <p class="eyebrow eyebrow--primary">Co-Founder and CTO</p>
                    </div>
                </div>
                <p class="body-copy-small body-copy-small--spaced">AI-first software architect and engineering leader with 8+ years of experience in high-scale governance and compliance.</p>
                <p class="body-copy-small body-copy-small--spaced">Savannah has led enterprise AI readiness, data standardization, and digital transformation initiatives at Capital One.</p>
                <p class="body-copy-small body-copy-small--spaced">He holds an MSc in Mechanical and Aerospace Engineering from the State University of New York (SUNY) at Buffalo.</p>
                <div class="profile-card__accent"></div>
            </article>

            <!-- Victor Card -->
            <article class="profile-card">
                <div class="profile-card__header">
                    <img alt="Victor Kagimu headshot" class="profile-card__avatar" loading="lazy" decoding="async" src="/static/images/victor_kagimu_headshot.avif">
                    <div>
                        <h3 class="heading-medium">Victor Kagimu</h3>
                        <p class="eyebrow eyebrow--primary">Co-Founder and COO</p>
                    </div>
                </div>
                <p class="body-copy-small body-copy-small--spaced">Technology entrepreneur with over a decade of experience building ventures across East Africa. </p>
                <p class="body-copy-small body-copy-small--spaced">Victor has led the company's investor relations and business development strategy from the ground up, and helped grow its customer base to 40+ enterprise clients across five countries. </p>
                <p class="body-copy-small body-copy-small--spaced">He holds an MSc in Information Technology from Carnegie Mellon University and was the inaugural recipient of the Innovation Forward Fellowship Fund.</p>
                <div class="profile-card__accent"></div>
            </article>
            
            <!-- Johnathon T. Davis Card -->
            <article class="profile-card">
                <div class="profile-card__header">
                    <img alt="Johnathon T. Davis headshot" class="profile-card__avatar" loading="lazy" decoding="async" src="/static/images/johnathon_t_davis_headshot.avif">
                    <div>
                        <h3 class="heading-medium">Johnathon T. Davis</h3>
                        <p class="eyebrow eyebrow--primary">Founding Board Member</p>
                    </div>
                </div>
                <p class="body-copy-small body-copy-small--spaced">Managing Partner at JT Davis Asset Management with deep experience in capital strategy, portfolio management, and market development.</p>
                <p class="body-copy-small body-copy-small--spaced">Johnathon holds a bachelor's degree in Business Marketing from the University of Kentucky and is registered as a Series 65 investment adviser in the Commonwealth of Kentucky.</p>
                <div class="profile-card__accent"></div>
            </article>

            <!-- Betsy M. Bevilacqua Card -->
            <article class="profile-card">
                <div class="profile-card__header">
                    <img alt="Betsy Mugo Bevilacqua headshot" class="profile-card__avatar" loading="lazy" decoding="async" src="/static/images/betsy_mugo_bevilacqua_headshot.avif">
                    <div>
                        <h3 class="heading-medium">Betsy M. Bevilacqua</h3>
                        <p class="eyebrow eyebrow--primary">Founding Member</p>
                    </div>
                </div>
                <p class="body-copy-small body-copy-small--spaced">Cybersecurity strategist with 15+ years leading security functions at Meta, eBay, and high-growth startups such as Chainalysis and Butterfly Network.</p>
                <p class="body-copy-small body-copy-small--spaced">Betsy helps organizations protect their data and systems so they can stay focused on what they do best.</p>
                <p class="body-copy-small body-copy-small--spaced">She holds an MBA in Finance from Canisius University.</p>
                <div class="profile-card__accent"></div>
            </article>                    

            <!-- Nate Dillard Card -->
            <article class="profile-card">
                <div class="profile-card__header">
                    <img alt="Nathan Nate Dillard headshot" class="profile-card__avatar" loading="lazy" decoding="async" src="/static/images/nathan_dillard_headshot.avif">
                    <div>
                        <h3 class="heading-medium">Nate Dillard</h3>
                        <p class="eyebrow eyebrow--primary">Chief Revenue Officer</p>
                    </div>
                </div>
                <p class="body-copy-small body-copy-small--spaced">Seasoned technologist, U.S. Air Force veteran, and serial entrepreneur with extensive experience in data-driven digital transformation and organizational growth.</p>
                <p class="body-copy-small body-copy-small--spaced">Nate leads enterprise growth strategy, market expansion, and commercial operations for emerging technology ventures, bridging sophisticated technical architecture with impactful market execution.</p>
                <p class="body-copy-small body-copy-small--spaced">He brings a robust background in defense systems and information management, complemented by leadership across high-growth digital initiatives.</p>
                <div class="profile-card__accent"></div>
            </article>
        </div>
    </div>
</section>

<!-- Core Values Section -->
<section class="content-section content-section--muted content-section--bordered" id="values">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <span class="section-kicker section-kicker--light">
                <span class="material-symbols-outlined icon-size-sm">volunteer_activism</span>
                <span class="eyebrow">Our Core Values</span>
            </span>
            <h2 class="section-heading">The <span>core principles</span> behind our work</h2>
            <p class="section-intro__description">
                We build every engagement around trust, human partnership, and measurable impact.
            </p>
        </div>

        <div class="feature-grid feature-grid--two-at-large">
            <article class="trust-card-no-hover group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">shield_lock</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Zero-Trust by Design</span></h3>
                </div>
                <p class="body-copy-small">
                    We never treat security as an afterthought. Your digital teammates operate inside private Sovereign Nodes with strict no-training, contractual zero-retention rules to protect your private data boundaries.
                </p>
            </article>

            <article class="trust-card-no-hover group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">groups</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Human Augmentation, Not Replacement</span></h3>
                </div>
                <p class="body-copy-small">
                    We build software to collaborate with your team, not replace them. Our tools handle the repetitive manual tasks under strict Human-in-the-Loop guardrails so your people can focus on strategy and real human connection.
                </p>
            </article>

            <article class="trust-card-no-hover group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">verified</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Uncompromising Integrity</span></h3>
                </div>
                <p class="body-copy-small">
                    We value verified facts over guesswork. Our system is engineered to check every record, flag conflicts, and refuse to invent false citations or alter data under pressure.
                </p>
            </article>

            <article class="trust-card-no-hover group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">hub</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Ecosystem Synergy</span></h3>
                </div>
                <p class="body-copy-small">
                    We partner wholesale with marketing agencies, consultants, and advisors rather than forcing high-friction direct sales. We create a win-win platform where trusted partners bring enterprise technology to their existing clients.
                </p>
            </article>

            <article class="trust-card-no-hover group feature-grid__wide-card">
                <div class="card-heading-row card-heading-row--centered">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">bolt</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Practical Real-World Impact</span></h3>
                </div>
                <p class="body-copy-small about-values__summary">
                    We build modular, fast-launch software designed to clear immediate office bottlenecks today, giving growing businesses and legal teams the reach of a much larger staff.
                </p>
            </article>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="callout-section" id="trusted-ai-partner-cta">
    <div class="callout">
        <div class="callout__overlay"></div>
        <div class="callout__content">
            <p class="callout__eyebrow">Meet the Team Behind Secure AI</p>
            <h2 class="callout__heading callout__heading--nowrap">Ready to Work with a <span>Trusted AI Partner?</h2>
            <p class="callout__description">
                Connect with our team to discuss your goals, evaluate secure deployment options, and design an implementation plan tailored to your organization.
            </p>
            <div class="callout__actions">
                <a class="btn-primary" href="/contact">Schedule a Strategy Call</a>
            </div>
        </div>
    </div>
</section>
{{end}}