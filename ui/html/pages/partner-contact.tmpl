{{define "main"}}
<!-- Hero Section -->  
<section class="page-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">groups</span>
            <span class="eyebrow">Channel Partner Application</span>
        </div>
        <h1 class="hero-title">
            Grow Your Practice with <span>Secure AI Delivery</span>
        </h1>
        <p class="hero-description">
            Apply to join Tabiri's channel partner network and tell us how your team delivers outcomes for enterprise or public-sector clients.
        </p>
    </div>
</section>

<!-- Partner Application Section -->
<section class="content-section content-section--light" id="partner-application">
    <div class="details-layout">
        <article class="trust-card details-layout__main">
            {{if .FormSubmitted}}
            <div class="submission-success submission-success--spaced" role="status">
                <div class="submission-success__summary">
                    <div class="icon-tile icon-tile--fixed icon-tile--success">
                        <span class="material-symbols-outlined">check_circle</span>
                    </div>
                    <div>
                        <h3 class="heading-compact">Thank you for applying</h3>
                        <p class="submission-success__message">Your partner application has been submitted successfully!</p>
                    </div>
                </div>
                <div class="submission-success__next">
                    <h4 class="heading-compact">Review Timeline</h4>
                    <ol class="submission-success__steps">
                        <li>
                            <span class="step-number">1</span>
                            <span class="step-description">Partner fit assessment</span>
                        </li>
                        <li>
                            <span class="step-number">2</span>
                            <span class="step-description">Architecture workshop</span>
                        </li>
                        <li>
                            <span class="step-number">3</span>
                            <span class="step-description">Pilot rollout plan</span>
                        </li>
                    </ol>
                    <a class="btn-secondary submission-success__return" href="/">Return to Homepage</a>
                </div>
            </div>
            {{else}}
                <div class="lead-form__heading">
                <div class="icon-tile icon-tile--inline">
                    <span class="material-symbols-outlined">handshake</span>
                </div>
                <div>
                    <h2 class="heading-compact">Apply To Become A Channel Partner</h2>
                    <p class="body-copy-small-compact">Tell us about your delivery model and client profile.</p>
                </div>
                </div>

                <form action="/partner-contact" class="lead-form" method="post">
                <input name="form_proof" type="hidden" value="{{.FormProof}}">
                <div aria-hidden="true" class="form-honeypot" hidden>
                    <label for="partner_website">Leave this field blank</label>
                    <input autocomplete="off" id="partner_website" name="website" tabindex="-1" type="text">
                </div>
                <div class="lead-form__fields">
                    <div class="lead-form__field">
                        <label class="form-label" for="partner_agency_name">Agency Name</label>
                        <input autocomplete="organization" class="form-field-input" id="partner_agency_name" maxlength="200" name="agency_name" placeholder="Global Consulting Group" required type="text" value="{{.PartnerContactForm.AgencyName}}">
                        {{with index .PartnerContactForm.Errors "agency_name"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                    </div>
                    <div class="lead-form__field">
                        <label class="form-label" for="partner_corporate_email">Corporate Email</label>
                        <input autocomplete="email" class="form-field-input" id="partner_corporate_email" maxlength="320" name="corporate_email" placeholder="partner@agency.com" required type="email" value="{{.PartnerContactForm.CorporateEmail}}">
                        {{with index .PartnerContactForm.Errors "corporate_email"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                    </div>
                </div>

                <div class="lead-form__fields">
                    <div class="lead-form__field">
                        <label class="form-label" for="partner_client_volume">Client Volume</label>
                        <select class="form-field-input" id="partner_client_volume" name="client_volume" required>
                            <option disabled {{if not .PartnerContactForm.ClientVolume}}selected{{end}} value="">Select client volume</option>
                            <option {{if eq .PartnerContactForm.ClientVolume "1-10"}}selected{{end}} value="1-10">1-10 Clients</option>
                            <option {{if eq .PartnerContactForm.ClientVolume "11-50"}}selected{{end}} value="11-50">11-50 Clients</option>
                            <option {{if eq .PartnerContactForm.ClientVolume "50+"}}selected{{end}} value="50+">50+ Clients</option>
                        </select>
                        {{with index .PartnerContactForm.Errors "client_volume"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                    </div>
                    <div class="lead-form__field">
                        <label class="form-label" for="partner_primary_vertical">Primary Vertical</label>
                        <input class="form-field-input" id="partner_primary_vertical" maxlength="200" name="primary_vertical" placeholder="Healthcare, Finance, Legal..." required type="text" value="{{.PartnerContactForm.PrimaryVertical}}">
                        {{with index .PartnerContactForm.Errors "primary_vertical"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                    </div>
                </div>

                <div class="lead-form__field">
                    <label class="form-label" for="partner_delivery_constraint">Current Delivery Constraint</label>
                    <textarea class="form-field-input" id="partner_delivery_constraint" maxlength="5000" name="delivery_constraint" placeholder="Describe where your team is constrained today and what you want to scale first..." required rows="4">{{.PartnerContactForm.DeliveryConstraint}}</textarea>
                    {{with index .PartnerContactForm.Errors "delivery_constraint"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                </div>

                    <div class="lead-form__field">
                        <div class="cf-turnstile" data-action="partner_contact_submit" data-sitekey="{{.TurnstileSiteKey}}" data-size="flexible"></div>
                        {{with index .PartnerContactForm.Errors "verification"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                    </div>
                    <button class="btn-primary lead-form__submit" type="submit">Request Partner Review</button>
                </form>

                <div class="lead-form__security">
                    <div class="lead-form__security-item">
                        <span class="material-symbols-outlined">security</span>
                        <p class="body-copy-small-compact">SOC2 compliant architecture</p>
                    </div>
                </div>
            {{end}}            
        </article>

        <div class="card-stack">
            <article class="trust-card">
                <div class="card-heading-row card-heading-row--spacious">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">mail</span>
                    </div>
                    <h2 class="heading-compact">Email Direct</h2>
                </div>
                <p class="body-copy-small body-copy-small--primary">info@tabirianalytics.com</p>
            </article>

            <article class="trust-card">
                <div class="card-heading-row card-heading-row--spacious">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">support_agent</span>
                    </div>
                    <h2 class="heading-compact">Availability</h2>
                </div>
                <p class="body-copy-small">Mon-Fri: 9am - 5pm EST</p>
            </article>

            {{if not .FormSubmitted}}
            <article class="trust-card">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">schedule</span>
                    </div>
                    <h3 class="heading-compact">Review Timeline</h3>
                </div>
                <ul class="partner-timeline">
                    <li class="body-copy-small-compact">Step 1: Partner fit assessment</li>
                    <li class="body-copy-small-compact">Step 2: Architecture workshop</li>
                    <li class="body-copy-small-compact">Step 3: Pilot rollout plan</li>
                </ul>
            </article>
            {{end}}

            <!--
            <article class="trust-card">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">security</span>
                    </div>
                    <h3 class="heading-compact">Security Baseline</h3>
                </div>
                <p class="body-copy-small-compact">All deployments align to private compute and enterprise-grade data control requirements.</p>
            </article>
            -->
        </div>
    </div>
</section>
{{end}}