{{define "main"}}
<!-- Hero Section -->  
<section class="relative py-14 md:py-16 px-gutter overflow-hidden bg-surface-container-lowest border-b border-outline-variant">
    <div class="absolute inset-0 opacity-40"></div>
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col items-center text-center">
        <div class="mb-8 flex items-center gap-2 px-3 py-1 bg-surface-container-low rounded-full border border-outline-variant">
            <span class="material-symbols-outlined icon-size-sm text-primary">groups</span>
            <span class="font-label text-label-sm text-on-surface">Channel Partner Application</span>
        </div>
        <h1 class="font-headline text-4xl md:text-display-lg text-on-background mb-6 md:mb-8 max-w-4xl">
            Grow Your Practice with <span class="text-primary">Secure AI Delivery</span>
        </h1>
        <p class="font-body text-body-lg text-on-surface-variant max-w-3xl">
            Apply to join Tabiri's channel partner network and tell us how your team delivers outcomes for enterprise or public-sector clients.
        </p>
    </div>
</section>

<!-- Partner Application Section -->
<section class="py-12 bg-surface" id="partner-application">
    <div class="max-w-7xl mx-auto px-gutter grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
        <article class="trust-card lg:col-span-2">
            {{if .FormSubmitted}}
            <div class="mb-6 flex items-start gap-4 rounded-xl border border-outline-variant bg-surface-container-low p-5" role="status">
                <div class="icon-tile mb-0 shrink-0 bg-primary/10">
                    <span class="material-symbols-outlined text-primary">check_circle</span>
                </div>
                <div>
                    <h3 class="font-headline text-headline-sm text-on-surface">Thank you for applying</h3>
                    <p class="mt-1 font-body text-body-sm text-on-surface-variant">Your partner application has been submitted successfully. Our partnerships team will review it and follow up with you.</p>
                    <a class="btn-secondary mt-4 inline-flex" href="/">Return to Homepage</a>
                </div>
            </div>
            {{else}}
                <div class="mb-6 flex items-center gap-4">
                <div class="icon-tile mb-0">
                    <span class="material-symbols-outlined text-primary">handshake</span>
                </div>
                <div>
                    <h2 class="font-headline text-headline-md text-on-surface">Apply To Become A Channel Partner</h2>
                    <p class="font-body text-body-sm text-on-surface-variant">Tell us about your delivery model and client profile.</p>
                </div>
                </div>

                <form action="/partner-contact" class="space-y-6" method="post">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="form-label" for="partner_agency_name">Agency Name</label>
                        <input autocomplete="organization" class="form-field-input" id="partner_agency_name" maxlength="200" name="agency_name" placeholder="Global Consulting Group" required type="text" value="{{.PartnerContactForm.AgencyName}}">
                        {{with index .PartnerContactForm.Errors "agency_name"}}<p class="text-sm text-error" role="alert">{{.}}</p>{{end}}
                    </div>
                    <div class="space-y-2">
                        <label class="form-label" for="partner_corporate_email">Corporate Email</label>
                        <input autocomplete="email" class="form-field-input" id="partner_corporate_email" maxlength="320" name="corporate_email" placeholder="partner@agency.com" required type="email" value="{{.PartnerContactForm.CorporateEmail}}">
                        {{with index .PartnerContactForm.Errors "corporate_email"}}<p class="text-sm text-error" role="alert">{{.}}</p>{{end}}
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-2">
                        <label class="form-label" for="partner_client_volume">Client Volume</label>
                        <select class="form-field-input" id="partner_client_volume" name="client_volume" required>
                            <option disabled {{if not .PartnerContactForm.ClientVolume}}selected{{end}} value="">Select client volume</option>
                            <option {{if eq .PartnerContactForm.ClientVolume "1-10"}}selected{{end}} value="1-10">1-10 Clients</option>
                            <option {{if eq .PartnerContactForm.ClientVolume "11-50"}}selected{{end}} value="11-50">11-50 Clients</option>
                            <option {{if eq .PartnerContactForm.ClientVolume "50+"}}selected{{end}} value="50+">50+ Clients</option>
                        </select>
                        {{with index .PartnerContactForm.Errors "client_volume"}}<p class="text-sm text-error" role="alert">{{.}}</p>{{end}}
                    </div>
                    <div class="space-y-2">
                        <label class="form-label" for="partner_primary_vertical">Primary Vertical</label>
                        <input class="form-field-input" id="partner_primary_vertical" maxlength="200" name="primary_vertical" placeholder="Healthcare, Finance, Legal..." required type="text" value="{{.PartnerContactForm.PrimaryVertical}}">
                        {{with index .PartnerContactForm.Errors "primary_vertical"}}<p class="text-sm text-error" role="alert">{{.}}</p>{{end}}
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="form-label" for="partner_delivery_constraint">Current Delivery Constraint</label>
                    <textarea class="form-field-input" id="partner_delivery_constraint" maxlength="5000" name="delivery_constraint" placeholder="Describe where your team is constrained today and what you want to scale first..." required rows="4">{{.PartnerContactForm.DeliveryConstraint}}</textarea>
                    {{with index .PartnerContactForm.Errors "delivery_constraint"}}<p class="text-sm text-error" role="alert">{{.}}</p>{{end}}
                </div>

                    <button class="btn-primary w-full" type="submit">Request Partner Review</button>
                </form>

                <div class="mt-8 pt-6 border-t border-outline-variant flex flex-col sm:flex-row gap-4 sm:gap-8">
                    <div class="flex items-center gap-3">
                        <span class="material-symbols-outlined text-primary">security</span>
                        <p class="font-body text-body-sm text-on-surface-variant">SOC2 compliant architecture</p>
                    </div>
                </div>
            {{end}}            
        </article>

        <div class="space-y-6">
            <article class="trust-card">
                <div class="mb-5 flex items-center gap-3">
                    <div class="icon-tile mb-0">
                        <span class="material-symbols-outlined text-primary">mail</span>
                    </div>
                    <h2 class="font-headline text-headline-md text-on-surface">Email Direct</h2>
                </div>
                <p class="font-body text-body-sm text-primary leading-relaxed">info@tabirianalytics.ai</p>
            </article>

            <article class="trust-card">
                <div class="mb-5 flex items-center gap-3">
                    <div class="icon-tile mb-0">
                        <span class="material-symbols-outlined text-primary">support_agent</span>
                    </div>
                    <h2 class="font-headline text-headline-md text-on-surface">Availability</h2>
                </div>
                <p class="font-body text-body-sm text-on-surface-variant leading-relaxed">Mon-Fri: 9am - 5pm EST</p>
            </article>

            <article class="trust-card">
                <div class="mb-4 flex items-center gap-3">
                    <div class="icon-tile mb-0">
                        <span class="material-symbols-outlined text-primary">schedule</span>
                    </div>
                    <h3 class="font-headline text-headline-md text-on-surface">Review Timeline</h3>
                </div>
                <ul class="space-y-2">
                    <li class="font-body text-body-sm text-on-surface-variant">Step 1: Partner fit assessment</li>
                    <li class="font-body text-body-sm text-on-surface-variant">Step 2: Architecture workshop</li>
                    <li class="font-body text-body-sm text-on-surface-variant">Step 3: Pilot rollout plan</li>
                </ul>
            </article>

            <!--
            <article class="trust-card">
                <div class="mb-4 flex items-center gap-3">
                    <div class="icon-tile mb-0">
                        <span class="material-symbols-outlined text-primary">security</span>
                    </div>
                    <h3 class="font-headline text-headline-md text-on-surface">Security Baseline</h3>
                </div>
                <p class="font-body text-body-sm text-on-surface-variant">All deployments align to private compute and enterprise-grade data control requirements.</p>
            </article>
            -->
        </div>
    </div>
</section>
{{end}}