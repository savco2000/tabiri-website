{{define "main"}}
<!-- Hero Section -->
<section class="data-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">lock</span>
            <span class="eyebrow">Sovereign Data Architecture</span>
        </div>
        <h1 class="hero-title">
            <span>Your Data Stays Yours.</span> <span class="hero-title__accent">Period</span>
        </h1>
        <p class="hero-description data-hero__description">
            Most standard AI tools steal your company secrets to train their models. Tabiri AI isolates your files inside a <span>private data vault</span>, ensuring your intellectual property never leaves your control.
        </p>
        <div class="hero-actions">
            <a class="btn-primary" href="/contact">Book a Data Privacy Call</a>
            <!--
            <a class="btn-secondary" href="/security-audit-2024">Security Audit 2024</a>
            -->
        </div>
    </div>
</section>

<!-- Sovereign Node Section -->
<section class="content-section content-section--muted content-section--bordered sovereign-section" id="sovereign-node">
    <div class="sovereign-layout">
        <div class="sovereign-layout__copy">
            <div class="eyebrow eyebrow--accent">INFRASTRUCTURE</div>
            <h2 class="section-heading sovereign-heading"><span>The Sovereign Node</span></h2>
            <p class="body-copy method-intro">
                Unlike public cloud AI platforms, Tabiri Analytics operates on a decentralized "Sovereign Node" model. This is an isolated workspace tailored specifically for your organization.
            </p>
            <ul class="sovereign-list">
                <li>
                    <span class="material-symbols-outlined">shield_with_heart</span>
                    <div>
                        <h3 class="heading-medium heading-medium--compact heading-medium--primary">Isolated Compute</h3>
                        <p class="body-copy-small-compact">
                            Your Digital Employees run on dedicated resources with no multi-tenancy leakage.
                        </p>
                    </div>
                </li>
                <li>
                    <span class="material-symbols-outlined">cloud_off</span>
                    <div>
                        <h3 class="heading-medium heading-medium--compact heading-medium--primary">Local or Private Cloud</h3>
                        <p class="body-copy-small-compact">
                            Deploy behind your own firewall, on-premise, or within a VPC on AWS/Azure.
                        </p>
                    </div>
                </li>
                <li>
                    <span class="material-symbols-outlined">encrypted</span>
                    <div>
                        <h3 class="heading-medium heading-medium--compact heading-medium--primary">End-to-End Encryption</h3>
                        <p class="body-copy-small-compact">
                            AES-256 encryption for data at rest and TLS 1.3 for data in transit.
                        </p>
                    </div>
                </li>
            </ul>
        </div>
        <div class="sovereign-layout__visual">
            <figure class="sovereign-layout__image">
                <img alt="Private compute infrastructure enclosing an isolated encrypted data node" width="1536" height="1024" loading="lazy" decoding="async" src="/static/images/sovereign-data-node.avif">
            </figure>
        </div>
    </div>
</section>

<!-- Trust Promises Section -->
<section class="content-section content-section--light" id="trust-pillars">
    <div class="section-container">
        <div class="section-intro">
            <h2 class="section-heading">Our Four Pillars of Trust</h2>
            <p class="section-intro__description">
                In an era of agentic AI, security isn't just a feature - it's the core substrate of our relationship with our partners.
            </p>
        </div>
        <div class="feature-grid feature-grid--four">
            <!-- Promise 1 -->
            <div class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">visibility_off</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">No Data Training</span></h3>
                </div>
                <p class="body-copy-small">
                    We never use your proprietary data, prompts, or documents to train or fine-tune our global AI models. Your IP remains exclusively yours.
                </p>
            </div>

            <!-- Promise 2 -->
            <div class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">grid_view</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Total Isolation</span></h3>
                </div>
                <p class="body-copy-small">
                    Every Digital Associate operates within a containerized environment. Data cannot bleed between agents or cross organizational boundaries.
                </p>
            </div>

            <!-- Promise 3 -->
            <div class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">history_edu</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Accountability Logging</span></h3>
                </div>
                <p class="body-copy-small">
                    Full cryptographic audit trails for every action taken by an AI. Export logs directly to your SIEM for total transparency.
                </p>
            </div>

            <!-- Promise 4 -->
            <div class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">lan</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Default Network Lock</span></h3>
                </div>
                <p class="body-copy-small">
                    Nodes operate with strict egress rules. Agents cannot communicate with the outside internet unless explicitly whitelisted.
                </p>
            </div>
        </div>

        <!-- Technical Validation -->
        <div class="compliance-layout">
            <!--Enterprise Compliance-->
            <div class="compliance-card">
                <div class="compliance-card__header">
                    <div>
                        <h3 class="section-heading sovereign-heading">Enterprise Compliance</h3>
                        <p class="compliance-card__description">Built for highly regulated industries like Defense, Fintech, and Healthcare.</p>
                    </div>
                    <div class="compliance-card__badges">
                        <div class="compliance-badge">SOC2 TYPE II</div>
                        <div class="compliance-badge compliance-badge--primary">HIPAA</div>
                        <div class="compliance-badge compliance-badge--purple">GDPR</div>
                    </div>
                </div>
                <div class="compliance-controls">
                    <div class="compliance-controls__row compliance-controls__row--bordered">
                        <div class="compliance-controls__name">
                            <span class="material-symbols-outlined">verified_user</span>
                            <span class="compliance-controls__title">Vulnerability Disclosure Program</span>
                        </div>
                        <span class="compliance-controls__status">Active</span>
                    </div>
                    <div class="compliance-controls__row compliance-controls__row--bordered">
                        <div class="compliance-controls__name">
                            <span class="material-symbols-outlined">security_update_good</span>
                            <span class="compliance-controls__title">Automated Penetration Testing</span>
                        </div>
                        <span class="compliance-controls__status">Quarterly</span>
                    </div>
                    <div class="compliance-controls__row">
                        <div class="compliance-controls__name">
                            <span class="material-symbols-outlined">fingerprint</span>
                            <span class="compliance-controls__title">Biometric &amp; MFA Hardware Support</span>
                        </div>
                        <span class="compliance-controls__status">Ready</span>
                    </div>
                    </div>
            </div>
            <div class="command-card">
                <div class="command-card__glow"></div>
                <div>
                    <span class="material-symbols-outlined material-symbols-filled icon-size-2xl command-card__icon">terminal</span>
                    <h3 class="section-heading command-card__heading">Command Central</h3>
                    <p class="command-card__description">Administer your Sovereign Node from a single, high-security dashboard.</p>
                </div>
                <a class="btn-secondary command-card__action" href="/contact">Request a Demo</a>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="callout-section" id="secure-ai-consultation-cta">
    <div class="callout">
        <div class="callout__overlay"></div>
        <div class="callout__content">
            <p class="callout__eyebrow">See Sovereign Security in Action</p>
            <h2 class="callout__heading callout__heading--nowrap">Ready for a <span>Secure AI Future?</span></h2>
            <p class="callout__description">
                Schedule a technical deep dive with our security engineering team to see how we protect your Sovereign Node.
            </p>
            <div class="callout__actions">
                <a class="btn-primary" href="/contact">Talk to a Specialist</a>
                <a class="btn-secondary" href="/case-studies.html">View Case Studies</a>
            </div>
        </div>
    </div>
</section>
{{end}}