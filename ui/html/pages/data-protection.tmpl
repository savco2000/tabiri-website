{{define "main"}}
<!-- Hero Section -->
<section class="relative py-14 md:py-16 px-gutter overflow-hidden bg-surface-container-lowest">
    <div class="absolute inset-0 opacity-40"></div>
    <div class="max-w-7xl mx-auto relative z-10 flex flex-col items-center text-center">
        <div class="mb-8 flex items-center gap-2 px-3 py-1 bg-surface-container-low rounded-full border border-outline-variant">
            <span class="material-symbols-outlined icon-size-sm text-primary">lock</span>
            <span class="font-label text-label-sm text-on-surface">Sovereign Data Architecture</span>
        </div>
        <h1 class="font-headline text-4xl md:text-display-lg text-on-background mb-6 md:mb-8 max-w-4xl">
            Your Data Stays Yours. <span class="text-accent">Period</span>
        </h1>
        <p class="font-body text-body-lg text-on-surface-variant max-w-2xl">
            Most standard AI tools steal your company secrets to train their models. Tabiri AI isolates your files inside a <span class="font-bold text-on-surface">private data vault</span>, ensuring your intellectual property never leaves your control.
        </p>
        <div class="mt-10 md:mt-12 flex flex-col sm:flex-row flex-wrap justify-center gap-4 sm:gap-6 w-full sm:w-auto">
            <a class="btn-primary w-full sm:w-auto" href="/contact">Book a Data Privacy Call</a>
            <!--
            <a class="btn-secondary w-full sm:w-auto" href="/security-audit-2024">Security Audit 2024</a>
            -->
        </div>
    </div>
</section>

<!-- Sovereign Node Section -->
<section class="py-12 bg-surface-container-low relative border-y border-outline-variant" id="sovereign-node">
