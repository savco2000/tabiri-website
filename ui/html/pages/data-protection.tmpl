                        </p>
                    </div>
                </li>
            </ul>
        </div>
        <div class="order-1 lg:order-2 flex justify-center">
            <!-- Technical Diagram -->
            <div class="relative w-full max-w-md aspect-square bg-surface-container-lowest rounded-xl shadow-xl p-6 border border-outline-variant flex flex-col justify-center items-center overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-primary-container/5 to-transparent"></div>
                <div class="absolute top-4 left-4 font-label text-label-sm text-outline uppercase tracking-widest">System Diagram // Node_Alpha_01</div>
                <div class="relative z-10 w-full h-full flex items-center justify-center">
                    <div class="w-32 h-32 rounded-full border-4 border-dashed border-primary/20 flex items-center justify-center motion-safe:animate-[spin_30s_linear_infinite] motion-reduce:animate-none">
                        <div class="w-24 h-24 rounded-full border-4 border-primary flex items-center justify-center bg-surface-container-lowest shadow-lg shadow-primary/10">
                            <span class="material-symbols-outlined material-symbols-filled icon-size-xl text-primary">security</span>
                        </div>
                    </div>
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full">
                        <div class="absolute top-[12%] left-[12%] p-2 bg-surface shadow-sm rounded-lg border border-outline-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-sm">database</span>
                            <span class="font-label text-label-sm font-bold text-on-surface">Encrypted Vault</span>
                        </div>
                        <div class="absolute bottom-[18%] right-[8%] p-2 bg-surface shadow-sm rounded-lg border border-outline-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-sm">robot_2</span>
                            <span class="font-label text-label-sm font-bold text-on-surface">Isolated Agent</span>
                        </div>
                        <div class="absolute top-[22%] right-[12%] p-2 bg-surface shadow-sm rounded-lg border border-outline-variant flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-sm">hub</span>
                            <span class="font-label text-label-sm font-bold text-on-surface">VPC Tunnel</span>
                        </div>
                    </div>
                    <svg class="absolute inset-0 w-full h-full opacity-10 pointer-events-none" viewBox="0 0 100 100">
                        <line class="text-primary" stroke="currentColor" stroke-width="0.75" x1="50" x2="15" y1="50" y2="15"></line>
                        <line class="text-primary" stroke="currentColor" stroke-width="0.75" x1="50" x2="85" y1="50" y2="25"></line>
                        <line class="text-primary" stroke="currentColor" stroke-width="0.75" x1="50" x2="80" y1="50" y2="80"></line>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

