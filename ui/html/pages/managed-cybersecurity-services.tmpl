{{define "main"}}
<!-- Hero Section -->
<section class="page-hero" id="continuous-monitoring-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">shield_lock</span>
            <span class="eyebrow">Managed Cybersecurity Services</span>
        </div>
        <h1 class="hero-title">
            Continuous Security Operations. <span>Faster, Controlled Response.</span>
        </h1>
        <p class="hero-description">
            Turn network and endpoint telemetry into prioritized investigations and coordinated action. Tabiri combines continuous monitoring, agent-assisted triage, and security engineering so your team can respond faster without handing consequential decisions to an unsupervised system.
        </p>
        
        <div class="hero-actions">
            <a class="btn-primary" href="/contact">Discuss Your Monitoring Coverage</a>
        </div>
        
    </div>
</section>

<!-- Customer Triggers -->
<section class="content-section content-section--light content-section--border-bottom" id="when-managed-security-fits">
    <div class="section-container">
        <div class="section-intro">
            <p class="eyebrow eyebrow--accent">When Continuous Monitoring Matters</p>
            <h2 class="section-heading">Close the Gap Between <span>Detection and Action</span></h2>
            <p class="section-intro__description">Managed security is most valuable when threat activity, alert volume, or operating requirements exceed the attention your internal team can sustain.</p>
        </div>
        <div class="feature-grid">
            <article class="trust-card group">
                <div class="card-heading-row"><div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">schedule</span></div><h3 class="heading-medium"><span class="heading-medium__highlight">Coverage Gaps</span></h3></div>
                <p class="body-copy-small">Extend visibility beyond business hours when a lean security or IT team cannot continuously watch endpoints, networks, and cloud activity.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row"><div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">notifications_active</span></div><h3 class="heading-medium"><span class="heading-medium__highlight">Alert Overload</span></h3></div>
                <p class="body-copy-small">Correlate repetitive alerts and preserve context so specialists spend less time reconstructing events and more time resolving material risk.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row"><div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">fact_check</span></div><h3 class="heading-medium"><span class="heading-medium__highlight">Evidence Demands</span></h3></div>
                <p class="body-copy-small">Maintain reviewable monitoring and response records for leadership, customers, regulators, insurers, and post-incident analysis.</p>
            </article>
        </div>
    </div>
</section>

<!-- Latency Bottleneck -->
<section class="content-section content-section--muted content-section--bordered" id="human-latency-bottleneck">
    <div class="monitoring-layout">
        <article class="trust-card-no-hover">
            <div class="card-heading-row card-heading-row--spacious">
                <div class="monitoring-warning__icon">
                    <span class="material-symbols-outlined">warning</span>
                </div>
                <h2 class="heading-medium heading-medium--accent">Why Manual Monitoring Falls Behind</h2>
            </div>
            <p class="body-copy-small body-copy-small--spaced">
                Analysts are most valuable when they can investigate intent, assess business impact, and direct response. Repetitive collection, enrichment, and correlation consume that capacity while threats continue to move.
            </p>
            <ul class="process-steps">
                <li class="monitoring-step">
                    <span class="material-symbols-outlined monitoring-step__icon" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">account_tree</span>
                    <div>
                        <h3 class="monitoring-step__heading monitoring-step__heading--accent">Fragmented Context</h3>
                        <p class="body-copy-small-compact">Signals spread across endpoints, networks, identities, and cloud services force analysts to rebuild the incident before they can act.</p>
                    </div>
                </li>
                <li class="monitoring-step">
                    <span class="material-symbols-outlined monitoring-step__icon" aria-hidden="true" style="font-variation-settings: 'FILL' 1;">timer</span>
                    <div>
                        <h3 class="monitoring-step__heading monitoring-step__heading--accent">Delayed Escalation</h3>
                        <p class="body-copy-small-compact">When every alert waits for manual enrichment, material threats can remain buried behind routine activity.</p>
                    </div>
                </li>
            </ul>
        </article>

        <article class="trust-card-no-hover">
            <div class="card-heading-row card-heading-row--spacious">
                <div class="icon-tile icon-tile--inline">
                    <span class="material-symbols-outlined">monitoring</span>
                </div>
                <h2 class="heading-medium heading-medium--primary">From Telemetry to Action</h2>
            </div>
            <ol class="process-steps">
                <li class="monitoring-step"><span class="process-step__number">01</span><div><h3 class="monitoring-step__heading">Collect Continuously</h3><p class="body-copy-small-compact">Centralize network and endpoint telemetry in Elastic Security for persistent visibility.</p></div></li>
                <li class="monitoring-step"><span class="process-step__number">02</span><div><h3 class="monitoring-step__heading">Correlate and Triage</h3><p class="body-copy-small-compact">Use machine-assisted analysis to connect related signals, preserve evidence, and prioritize investigation.</p></div></li>
                <li class="monitoring-step"><span class="process-step__number">03</span><div><h3 class="monitoring-step__heading">Escalate or Contain</h3><p class="body-copy-small-compact">Follow agreed response policies, with human approval required for consequential restoration and recovery decisions.</p></div></li>
            </ol>
        </article>
    </div>
</section>

<!-- 3-Tier OpenClaw Containment Logic -->
<section class="content-section content-section--light response-section" id="managed-response-model">
    <div class="response-intro">
        <p class="eyebrow eyebrow--accent">Controlled Response Model</p>
        <h2 class="section-heading">Match the Response to the <span>Risk and Business Impact</span></h2>
        <p class="response-intro__description">OpenClaw applies the monitoring and containment policy agreed with your team, escalating from observation to isolation or quarantine without treating every anomaly like a crisis.</p>
    </div>
    <div class="response-grid">
        <!-- Tier 1: Observational -->
        <div class="response-tier">
            <div class="response-tier__badge">
                TIER 1
            </div>
            <div class="response-tier__icon">
                <span class="material-symbols-outlined">visibility</span>
            </div>
            <h3 class="response-tier__heading">Observational</h3>
            <p class="response-tier__description">
                Observe suspicious activity and collect supporting telemetry without changing the process state, preserving business continuity while evidence develops.
            </p>
            <div class="response-tier__risk">
                <span class="response-tier__risk-label">RISK LEVEL</span>
                <span class="response-tier__risk-value">LOW</span>
            </div>
        </div>

        <!-- Tier 2: Precision Isolation -->
        <div class="trust-card-no-hover response-tier response-tier--prominent">
            <div class="response-tier__badge">
                TIER 2
            </div>
            <div class="response-tier__icon">
                <span class="material-symbols-outlined">gps_fixed</span>
            </div>
            <h3 class="response-tier__heading">Precision Isolation</h3>
            <p class="response-tier__description">
                Isolate an approved process or user session while preserving internal telemetry for investigation, limiting exposure without unnecessarily disrupting the wider environment.
            </p>
            <div class="response-tier__risk">
                <span class="response-tier__risk-label">RISK LEVEL</span>
                <span class="response-tier__risk-value">MEDIUM</span>
            </div>
        </div>

        <!-- Tier 3: Hard Quarantine -->
        <div class="response-tier response-tier--critical">
            <div class="response-tier__badge">
                TIER 3
            </div>
            <div class="response-tier__icon">
                <span class="material-symbols-outlined">security</span>
            </div>
            <h3 class="response-tier__heading">Hard Quarantine</h3>
            <p class="response-tier__description">
                Suspend a compromised node and initiate agreed credential protections when evidence meets the defined threshold. Human approval remains required for restoration.
            </p>
            <div class="response-tier__risk">
                <span class="response-tier__risk-label">RISK LEVEL</span>
                <span class="response-tier__risk-value">CRITICAL</span>
            </div>
        </div>

        <!-- Agentic Reasoning Engine -->
        <div class="reasoning-layout">
            <article class="trust-card-no-hover reasoning-card">
                <div class="reasoning-card__glow"></div>
                <div class="reasoning-card__content">
                    <h3 class="section-heading">Agentic Reasoning Engine</h3>
                    <p class="body-copy-small body-copy-small--spaced">
                        Unlike isolated static alerts, OpenClaw correlates behavioral telemetry, usage patterns, and peer baselines to build incident context. Security engineers define the response boundaries and review escalated activity.
                    </p>
                    <div class="reasoning-card__tags">
                        <span class="reasoning-card__tag"><span class="material-symbols-outlined">psychology</span>Neural Heuristics</span>
                        <span class="reasoning-card__tag"><span class="material-symbols-outlined">hub</span>Edge Deployment</span>
                    </div>
                </div>
            </article>

            <div class="reasoning-aside">
                <article class="trust-card-no-hover">
                    <p class="heading-medium heading-medium--primary heading-medium--compact">24/7 Telemetry</p>
                    <p class="body-copy-small-compact">Continuous network and endpoint visibility managed through a centralized security workspace.</p>
                </article>
                <article class="trust-card-no-hover">
                    <p class="heading-medium heading-medium--primary heading-medium--compact">Reviewable Response</p>
                    <p class="body-copy-small-compact">Preserved evidence, documented actions, and clear escalation paths support investigation and accountability.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<!-- Product Demo -->
<section class="content-section content-section--muted content-section--bordered" id="agentic-secops-demo">
    <div class="section-container">
        <div class="demo-intro">
            <p class="eyebrow eyebrow--accent">See Agentic SecOps in Action</p>
            <h2 class="section-heading">Watch the <span>Technical Product Demo</span></h2>
            <p class="body-copy">See how Tabiri's managed security operations combine agentic analysis with engineer-led oversight and controlled response.</p>
        </div>
        <div class="demo-video">
            <iframe
                src="https://www.youtube-nocookie.com/embed/iIEoY2s8uvE"
                title="Tabiri Agentic SecOps technical product demo"
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow="encrypted-media; picture-in-picture; web-share"
                allowfullscreen></iframe>
        </div>
        <div class="demo-action">
            <a class="btn-primary" href="/contact">Discuss Your Security Operations</a>
        </div>
    </div>
</section>

