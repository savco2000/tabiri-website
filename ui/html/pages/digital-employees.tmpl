                                <defs>
                                    <style>
                                    :root {
                                        /* TABIRI ANALYTICS - BRAND THEME VARIABLES */
                                        --bg-main: transparent;
                                        
                                        /* Human Supervisor - Deep Slate / Corporate Navy */
                                        --color-supervisor-bg: #1E293B;  
                                        --color-supervisor-text: #F8FAFC;
                                        
                                        /* AI Agents - Color Swapped (was blue bg / white inner) */
                                        /* New Outer Background (was white inner) */
                                        --color-agent-bg: rgba(255, 255, 255, 0.75);       
                                        --color-agent-border: #7DD3FC;
                                        --color-agent-text: #0369A1;
                                        /* New Inner Background (was blue agent bg) */
                                        --color-agent-inner-bg: #E0F2FE; 
                                        
                                        /* Guardrails Layer - Secure Green */
                                        --color-semantic-bg: #D1FAE5;    
                                        --color-semantic-border: #6EE7B7;
                                        --color-semantic-text: #065F46;
                                        
                                        /* Data & Infrastructure - Slate Gray */
                                        --color-data-bg: #F1F5F9;        
                                        --color-data-border: #CBD5E1;
                                        --color-data-text: #475569;
                                        
                                        /* Lines & Connectors */
                                        --color-arrow: #94A3B8;
                                        --font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                                    }
                                    
                                    .font-sans { font-family: var(--font-family); }
                                    
                                    /* Base Box Styling */
                                    .box {
                                        rx: 8px; 
                                        ry: 8px; 
                                        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.05));
                                    }
                                    
                                    /* Component Classes */
                                    .box-human { fill: var(--color-supervisor-bg); }
                                    .box-agent { fill: var(--color-agent-bg); stroke: var(--color-agent-border); stroke-width: 2; }
                                    .box-agent-inner { fill: var(--color-agent-inner-bg); rx: 4px; ry: 4px; }
                                    .box-semantic { fill: var(--color-semantic-bg); stroke: var(--color-semantic-border); stroke-width: 2; }
                                    .box-data { fill: var(--color-data-bg); stroke: var(--color-data-border); stroke-width: 2; }
                                    
                                    /* Typography */
                                    .text-title { font-size: 18px; font-weight: 700; text-anchor: middle; dominant-baseline: middle; letter-spacing: 0.5px; }
                                    .text-human { fill: var(--color-supervisor-text); font-size: 22px; }
                                    .text-agent { fill: var(--color-agent-text); font-size: 16px; }
                                    .text-agent-inner { fill: var(--color-agent-text); font-size: 14px; font-weight: 500; text-anchor: middle; dominant-baseline: middle; }
                                    .text-semantic { fill: var(--color-semantic-text); font-size: 20px; }
                                    .text-data { fill: var(--color-data-text); font-size: 16px; }
                                    
                                    /* Connectors */
                                    .arrow { stroke: var(--color-arrow); stroke-width: 2; fill: none; }
                                    .arrow-head { fill: var(--color-arrow); }
                                    </style>
                                    
