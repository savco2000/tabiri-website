                    <div class="case-metric"><p class="case-metric__value">30+</p><p class="body-copy-small-compact">recordings transcribed</p></div>
                    <div class="case-metric"><p class="case-metric__value">200+</p><p class="body-copy-small-compact">images processed</p></div>
                    <div class="case-metric"><p class="case-metric__value">100%</p><p class="body-copy-small-compact">of citations from approved databases</p></div>
                </div>
            </div>
            <div class="proof-card__footer">
                <a class="text-link" href="/case-studies.html">Explore the Digital Employee case study <span class="material-symbols-outlined icon-size-sm">arrow_forward</span></a>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
