<!-- Anatomy of the Digital Employees Section -->
<section class="content-section content-section--light content-section--border-top" id="digital-employees-anatomy">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <span class="section-kicker">
                <span class="material-symbols-outlined icon-size-sm">hub</span>
                <span class="eyebrow">Anatomy of the Digital Employees</span>
            </span>
            <h2 class="section-heading">Human-Supervised Intelligence with <span>Safety Guardrails</span></h2>
            <p class="section-intro__description section-intro__description--wide">A clear operating model that keeps human employees in control while each specialist executes with precision within safety guardrails.</p>
        </div>

        <div class="operating-model">
            <div class="operating-model__frame">
                <div class="operating-model__panel">
                    <div class="operating-model__header">
                        <div class="operating-model__header-content">
                            <div>
                                <p class="operating-model__label">Operating Model</p>
                                <h3 class="heading-medium">Human-agent collaboration at a glance</h3>
                            </div>
                            <div class="operating-model__badge">
                                <span class="material-symbols-outlined">shield_lock</span>
                                Secure by design
                            </div>
                        </div>
                    </div>
                    <div class="operating-model__body">
                        <div class="operating-model__layout">
                            <figure class="operating-model__image">
                                <img alt="Digital employee activity flowing from approved data through guardrails and continuous assurance to human review and intervention" width="1536" height="1024" loading="lazy" decoding="async" src="/static/images/digital-employees-operating-model.avif">
                            </figure>


                            <div class="operating-model__details">
                                <h4 class="heading-medium operating-model__heading">Guardrails Define. <span class="heading-medium__highlight">Continuous Assurance Verifies.</span></h4>
                                <p class="body-copy-spaced">Guardrails establish approved data, permissions, and escalation paths before work begins.</p>
                                <p class="body-copy-spaced">Continuous assurance makes activity, behavioral change, and human intervention visible once the workflow is operating.</p>
                                <ul class="operating-model__list">
                                    <li>
                                        <span class="material-symbols-outlined">lock</span>
                                        <span class="body-copy-small-compact">Approved data sources and explicit permissions bound what each specialist can access and do.</span>
                                    </li>
                                    <li>
                                        <span class="material-symbols-outlined">monitoring</span>
                                        <span class="body-copy-small-compact">Runtime signals help teams identify drift, risky delegation, and actions that need investigation.</span>
                                    </li>
                                    <li>
                                        <span class="material-symbols-outlined">gpp_good</span>
                                        <span class="body-copy-small-compact">Reviewers see evidence and retain authority to approve, redirect, pause, or stop high-impact work.</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Continuous Assurance Section -->
<section class="content-section content-section--light content-section--border-top" id="continuous-assurance">
    <div class="section-container">
        <div class="assurance-intro">
            <span class="section-kicker">
                <span class="material-symbols-outlined icon-size-sm">monitoring</span>
                <span class="assurance-intro__label">Continuous Assurance</span>
            </span>
            <h2 class="section-heading assurance-intro__title">Control at Deployment. <span class="heading-medium__highlight">Assurance During Operation.</span></h2>
            <p class="body-copy body-copy--relaxed assurance-intro__description">Pre-deployment safeguards establish how a digital employee should work. Continuous assurance helps your team verify that permissions, intervention paths, and accountable behavior remain visible as the workflow operates.</p>
            <p class="body-copy body-copy--relaxed assurance-intro__description assurance-intro__description--following">Tabiri brings an operating mindset shaped by <a href="/case-studies#cdp-mapsync">continuous cybersecurity monitoring</a>: establish a baseline, identify meaningful change, connect signals to accountable intervention, and improve controls using production evidence. Digital employees require additional visibility into permissions, tool use, delegation, and human oversight.</p>
        </div>

        <div class="assurance-grid">
            <article class="trust-card-no-hover">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">badge</span>
                    </div>
                    <h3 class="heading-medium heading-medium--primary">Named Identity</h3>
                </div>
                <p class="body-copy-small">Connect activity to a specific digital employee and the role, workflow, and authority under which it acted.</p>
            </article>

            <article class="trust-card-no-hover">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">manage_accounts</span>
                    </div>
                    <h3 class="heading-medium heading-medium--primary">Permission Visibility</h3>
                </div>
                <p class="body-copy-small">Keep access boundaries and approval modes reviewable so changes can be identified and examined.</p>
            </article>

            <article class="trust-card-no-hover">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">gpp_good</span>
                    </div>
                    <h3 class="heading-medium heading-medium--primary">Human Intervention</h3>
                </div>
                <p class="body-copy-small">Define who can approve, stop, or redirect sensitive actions and preserve evidence of those decisions.</p>
            </article>

            <article class="trust-card-no-hover">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline">
                        <span class="material-symbols-outlined">monitoring</span>
                    </div>
                    <h3 class="heading-medium heading-medium--primary">Change Detection</h3>
                </div>
                <p class="body-copy-small">Watch for meaningful shifts in escalation, source use, or other behavior that matters to the workflow.</p>
            </article>
        </div>

        <div class="assurance-callout">
            <div class="assurance-callout__layout">
                <div class="method-note__content">
                    <div class="icon-tile icon-tile--fixed icon-tile--success">
                        <span class="material-symbols-outlined">shield_with_heart</span>
                    </div>
                    <div>
                        <h3 class="heading-medium heading-medium--primary heading-medium--compact">Match assurance to the stakes</h3>
                        <p class="body-copy-small assurance-callout__description">High-impact or difficult-to-reverse actions warrant stronger records, alerts, and approval gates. Routine work can use lighter monitoring and shorter retention.</p>
                    </div>
                </div>
                <div class="assurance-callout__actions">
                    <a class="btn-primary" data-analytics-download="continuous_assurance_checklist" download="Tabiri-Continuous-Assurance-Checklist.pdf" href="/static/tabiri_continuous_assurance_checklist.pdf">
                        <span class="material-symbols-outlined icon-size-sm">download</span>
                        Download the Checklist
                    </a>
                    <a class="btn-secondary" href="/automation-assessment">Check Workflow Readiness</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Proven Outcomes Section -->
<section class="content-section content-section--muted content-section--border-top" id="digital-employee-results">
    <div class="section-container">
        <div class="proof-card">
