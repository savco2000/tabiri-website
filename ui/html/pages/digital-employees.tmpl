                                <!-- SEMANTIC LAYER -->
                                <rect x="50" y="380" width="900" height="80" class="box box-semantic" />
                                <text x="500" y="422" class="font-sans text-title text-semantic">ONTOLOGY-BASED SEMANTIC LAYER (GUARDRAILS)</text>

                                <!-- DATA LAYER -->
