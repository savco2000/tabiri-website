{{define "main"}}
<!-- Hero Section -->
<section class="page-hero" id="digital-employees-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">groups</span>
            <span class="eyebrow">Digital Employees</span>
        </div>
        <h1 class="hero-title">
            The <span>Human + Digital Team</span> That Scales Without Friction
        </h1>
        <p class="hero-description">
            Return valuable capacity to your team without giving up control. Tabiri's specialized Digital Employees handle repetitive operational work while your people retain judgment, escalation, final approval, and accountability.
        </p>
        
        <div class="hero-actions">
            <a class="btn-primary" href="/contact">Book a Discovery Call</a>
            <a class="btn-secondary" href="/automation-assessment">Check Workflow Readiness</a>
        </div>
        
    </div>
</section>

<!-- Customer Triggers Section -->
<section class="content-section content-section--light content-section--border-bottom" id="when-digital-employees-fit">
    <div class="section-container">
        <div class="section-intro">
            <p class="eyebrow eyebrow--accent">When Digital Employees Fit</p>
            <h2 class="section-heading">Scale the Work, <span>Not the Workload</span></h2>
            <p class="section-intro__description">The strongest candidates are recurring workflows where volume, handoffs, and manual review consume skilled time but the rules and escalation points can be clearly defined.</p>
        </div>
        <div class="feature-grid">
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">repeat</span></div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Repetitive Work</span></h3>
                </div>
                <p class="body-copy-small">Automate frequent, rules-based intake, document processing, reconciliation, monitoring, and routing that pulls specialists away from higher-value work.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">account_tree</span></div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Operational Friction</span></h3>
                </div>
                <p class="body-copy-small">Reduce backlogs, inconsistent handoffs, avoidable errors, and response delays across the business systems your teams already use.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">policy</span></div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">High-Trust Operations</span></h3>
                </div>
                <p class="body-copy-small">Apply AI to sensitive or compliance-intensive work with approved data sources, explicit permissions, reviewable outputs, and human approval gates.</p>
            </article>
        </div>
    </div>
</section>

