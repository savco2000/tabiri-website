        <div class="callout__overlay"></div>
        <div class="callout__content">
            <p class="callout__eyebrow">Meet Your Next Digital Teammate</p>
            <h2 class="callout__heading callout__heading--nowrap">Bring <span>Digital Employees</span> Into Your Team</h2>
            <p class="callout__description">
                Give your people specialist AI support for the work that repeats every day, while keeping oversight, accountability, and control in human hands.
            </p>
            <div class="callout__actions">
                <a class="btn-primary" href="/contact">Book a Discovery Call</a>
            </div>
        </div>
    </div>
</section>
{{end}}