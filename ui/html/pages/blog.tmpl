{{define "main"}}
<!-- Hero Section -->
<section class="page-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">article</span>
            <span class="eyebrow">Insights & Playbooks</span>
        </div>
        <h1 class="hero-title">
            Ideas, signals, and <span>secure AI operating models</span> for the modern enterprise
        </h1>
        <p class="hero-description">
            Practical thinking for teams that want to automate operations without compromising privacy, trust, or human accountability.
        </p>
        <div class="blog-topics">
            <span>AI Strategy</span>
            <span>Cybersecurity</span>
            <span>Operational Design</span>
            <span>Governance</span>
        </div>
    </div>
</section>

<!-- Featured Post Section -->
<section class="content-section content-section--muted content-section--border-bottom" id="featured-post">
    <div class="section-container">
        <article class="featured-post">
            <div class="featured-post__image">
                <img alt="AI agent activity flowing through observability signals to a human review console" width="1600" height="1067" src="/static/images/continuous-agent-monitoring.avif">
            </div>
            <div class="featured-post__content">
                <span class="featured-post__badge">Featured article</span>
                <h2 class="featured-post__title">Why AI guardrails are not enough: the case for continuous agent monitoring</h2>
                <p class="featured-post__description">
                    What continuous cybersecurity monitoring teaches us about governing AI agent permissions, delegation, behavioral drift, evidence, and human intervention.
                </p>
                <div class="featured-post__meta">
                    <span>November 5, 2026</span>
                    <span>•</span>
                    <span>8 min read</span>
                </div>
                <div class="featured-post__action">
                    <a class="btn-primary" href="/blog/why-ai-guardrails-are-not-enough-continuous-agent-monitoring">Read the article</a>
                </div>
            </div>
        </article>
    </div>
</section>

