{{define "main"}}
<!-- Hero Section -->
<section class="assessment-hero">
    <div class="assessment-hero__content">
        <div class="section-kicker assessment-hero__kicker">
            <span class="material-symbols-outlined icon-size-sm">checklist</span>
            <span class="eyebrow">Five questions · About two minutes</span>
        </div>
        <h1 class="assessment-hero__title">Is Your Business Ready for <span>AI Automation?</span></h1>
        <p class="assessment-hero__description">Assess one workflow that consumes your team's time. You will get an immediate recommendation based on its volume, structure, systems, and oversight needs.</p>
    </div>
</section>

<!-- Automation Assessment Section -->
<section class="assessment-section">
    <div class="assessment-section__content">
        <!-- Pre-assessment State -->
        <article aria-live="polite" class="trust-card-no-hover" id="assessment-result" tabindex="-1">
            <div class="assessment-result__intro">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--fixed"><span class="material-symbols-outlined" id="result-icon">insights</span></div>
                    <p class="eyebrow eyebrow--primary" id="result-label">Start Assessment</p>
                </div>
                <h2 class="assessment-result__heading" id="result-heading">Complete the assessment to see your recommendation.</h2>
                <p class="body-copy" id="result-copy">Answer all five questions below to learn whether this workflow is ready for secure AI automation.</p>
            </div>

            <form class="assessment-form" id="automation-assessment-form">
            <div class="assessment-form__intro">
                <label class="heading-compact" for="assessment-workflow">Which workflow are you assessing?</label>
                <p class="body-copy-small-compact">Name one process, such as invoice reconciliation, customer onboarding, or compliance reporting.</p>
                <input class="form-field-input" id="assessment-workflow" maxlength="200" name="workflow_name" placeholder="e.g. Monthly invoice reconciliation" required type="text">
            </div>

            <fieldset>
                <legend class="assessment-question__title"><span class="assessment-question__number">01</span> How often does the workflow repeat?</legend>
                <div class="assessment-question__options">
                    <label class="assessment-option"><input class="assessment-option__input" name="frequency" required type="radio" value="0"><span class="assessment-option__label">A few times a month</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="frequency" type="radio" value="1"><span class="assessment-option__label">Several times a week</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="frequency" type="radio" value="2"><span class="assessment-option__label">Daily or continuously</span></label>
                </div>
            </fieldset>

            <fieldset>
                <legend class="assessment-question__title"><span class="assessment-question__number">02</span> How consistent are the steps and decisions?</legend>
                <div class="assessment-question__options">
                    <label class="assessment-option"><input class="assessment-option__input" name="consistency" required type="radio" value="0"><span class="assessment-option__label">Mostly unique each time</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="consistency" type="radio" value="1"><span class="assessment-option__label">A repeatable core with exceptions</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="consistency" type="radio" value="2"><span class="assessment-option__label">Clear rules and standard steps</span></label>
                </div>
            </fieldset>

            <fieldset>
                <legend class="assessment-question__title"><span class="assessment-question__number">03</span> Where does the work happen?</legend>
                <div class="assessment-question__options">
                    <label class="assessment-option"><input class="assessment-option__input" name="systems" required type="radio" value="0"><span class="assessment-option__label">Mostly offline or unstructured</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="systems" type="radio" value="1"><span class="assessment-option__label">Across email and documents</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="systems" type="radio" value="2"><span class="assessment-option__label">In connected business software</span></label>
                </div>
            </fieldset>

            <fieldset>
                <legend class="assessment-question__title"><span class="assessment-question__number">04</span> What impact does the manual work have?</legend>
                <div class="assessment-question__options">
                    <label class="assessment-option"><input class="assessment-option__input" name="impact" required type="radio" value="0"><span class="assessment-option__label">Little measurable impact</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="impact" type="radio" value="1"><span class="assessment-option__label">Some delay or avoidable cost</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="impact" type="radio" value="2"><span class="assessment-option__label">Backlogs, errors, or lost capacity</span></label>
                </div>
            </fieldset>

            <fieldset>
                <legend class="assessment-question__title"><span class="assessment-question__number">05</span> Can a person review exceptions or sensitive decisions?</legend>
                <div class="assessment-question__options">
                    <label class="assessment-option"><input class="assessment-option__input" name="oversight" required type="radio" value="0"><span class="assessment-option__label">No clear reviewer or intervention process</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="oversight" type="radio" value="1"><span class="assessment-option__label">Someone can review flagged exceptions</span></label>
                    <label class="assessment-option"><input class="assessment-option__input" name="oversight" type="radio" value="2"><span class="assessment-option__label">A named reviewer can approve, stop, or redirect sensitive actions</span></label>
                </div>
            </fieldset>

            <button class="btn-primary assessment-form__submit" type="submit">See My Recommendation</button>
            <p class="body-copy-small-compact">No email address is required. Your answers stay in your browser unless you choose to discuss the result with us.</p>
            </form>
            <noscript><p class="assessment-form__script-warning">Enable JavaScript to calculate your automation readiness recommendation.</p></noscript>
        </article>

        <!-- Post-assessment State -->
        <article aria-live="polite" class="assessment-result" id="post-assessment-result" tabindex="-1" hidden>
            <div class="assessment-result__layout">
                <div class="icon-tile icon-tile--fixed"><span class="material-symbols-outlined" id="assessment-result-icon">insights</span></div>
                <div class="assessment-result__content">
                    <p class="assessment-result__eyebrow" id="assessment-result-label"></p>
                    <h2 class="assessment-result__heading"><span id="assessment-result-heading"></span> <span class="assessment-result__heading-emphasis" id="assessment-result-heading-emphasis"></span></h2>
                    <p class="assessment-result__copy" id="assessment-result-copy"></p>
                    <h3 class="assessment-result__subheading">What shaped this recommendation</h3>
                    <ul class="assessment-result__factors" id="assessment-result-factors"></ul>
                    <div class="assessment-result__note">
                        <h3 class="assessment-result__subheading assessment-result__subheading--compact">Secure deployment is only the first step</h3>
                        <p class="body-copy-small">Before launch, define what the digital employee may access, which actions require approval, and what activity must be monitored or retained for review.</p>
                    </div>
                    <div class="assessment-result__actions">
                        <a class="btn-primary" href="/contact" id="assessment-contact-cta">Discuss This Workflow</a>
                        <a class="btn-secondary" data-analytics-download="continuous_assurance_checklist" download="Tabiri-Continuous-Assurance-Checklist.pdf" href="/static/tabiri_continuous_assurance_checklist.pdf" id="assurance-checklist-download">
                            <span class="material-symbols-outlined icon-size-sm">download</span>
                            Download the Continuous Assurance Checklist
                        </a>
                    </div>
                </div>
            </div>
        </article>
    </div>
</section>
{{end}}