{{define "main"}}
<!-- 404 Error Section -->
<section class="bg-surface-container-low px-gutter py-12">
    <article class="trust-card-no-hover relative mx-auto max-w-3xl overflow-hidden py-6 text-center md:py-8">
        <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-primary/10 blur-3xl"></div>
        <div class="relative z-10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-outline-variant bg-surface-container-low mb-4">
                <span class="material-symbols-outlined icon-size-sm text-primary">error</span>
                <span class="font-label text-label-sm text-on-surface uppercase tracking-wider">Error</span>
            </div>
            <h1 class="font-headline text-4xl md:text-display-lg text-on-background mb-3">404 - Page Not Found</h1>
            <p class="font-body text-body-md text-on-surface-variant max-w-2xl mx-auto mb-5">
                The page you are looking for might have been moved, renamed, or no longer exists.
            </p>
            <figure class="max-w-xl mx-auto mb-5 rounded-xl border border-outline-variant bg-surface-container-low overflow-hidden">
                <img alt="A confused robot looking at a map under a 404 sign" class="w-full h-auto" width="640" height="360" fetchpriority="high" decoding="async" src="/static/svg/lost-bot-404.svg">
                <figcaption class="font-label text-label-sm text-on-surface-variant px-4 py-3 border-t border-outline-variant">
                    Even our bot took a wrong turn.
                </figcaption>
            </figure>
            <a class="btn-primary w-full sm:w-auto" href="/">Return to Homepage</a>
        </div>
    </article>
</section>
{{end}}