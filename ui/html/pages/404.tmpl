{{define "main"}}
<!-- 404 Error Section -->
<section class="not-found">
    <article class="trust-card-no-hover not-found__card">
        <div class="not-found__glow"></div>
        <div class="not-found__content">
            <div class="section-kicker">
                <span class="material-symbols-outlined icon-size-sm">error</span>
                <span class="eyebrow">Error</span>
            </div>
            <h1 class="not-found__title">404 - Page Not Found</h1>
            <p class="not-found__description">
                The page you are looking for might have been moved, renamed, or no longer exists.
            </p>
            <figure class="not-found__figure">
                <img alt="A confused robot looking at a map under a 404 sign" width="640" height="360" fetchpriority="high" decoding="async" src="/static/svg/lost-bot-404.svg">
                <figcaption>
                    Even our bot took a wrong turn.
                </figcaption>
            </figure>
            <a class="btn-primary not-found__home" href="/">Return to Homepage</a>
        </div>
    </article>
</section>
{{end}}