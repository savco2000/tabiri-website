{{define "main"}}
<!-- Hero Section -->
<section class="home-hero">
    <div class="hero-overlay"></div>
    <div class="hero-split">
        <div class="hero-split__copy">
            <div class="hero-kicker">
                <span class="material-symbols-outlined icon-size-sm">shield_lock</span>
                <span class="eyebrow">The Governed Digital Workforce</span>
            </div>
            <h1 class="hero-title">
                Need <span>Secure AI Employees</span><br>That Extend Your Team, <span class="hero-title__accent--block">Not Your Payroll?</span>
            </h1>
            <p class="hero-description hero-description--compact">
                We develop secure and reliable AI-powered employees that collaborate with your team, <span class="hero-description__emphasis">not replace them</span>. Guardrails alone aren't enough, so we draw on our deep cybersecurity roots to continuously monitor every AI employee - keeping your data private and every action accountable.
            </p>
            <div class="hero-actions hero-actions--left">
                <a class="btn-primary" href="/contact">Deploy Your Node</a>
                <a class="btn-secondary" data-analytics-download="one_pager" download="Tabiri-Analytics-One-Pager.pdf" href="/static/tabiri_analytics_one_pager.pdf">
                    <span class="material-symbols-outlined icon-size-sm">download</span>
                    Download Our One-Pager
                </a>
            </div>
        </div>
        <div class="hero-split__visual">
            <div class="hero-split__glow"></div>
            <div class="hero-split__frame">
                <img alt="Tabiri Office Environment" class="hero-split__image" width="512" height="512" fetchpriority="high" decoding="async" src="/static/images/tabiri_office_environment.avif">
            </div>
        </div>
    </div>
</section>

<!-- The Office Problem -->
<section class="content-section content-section--muted content-section--bordered" id="office-problem">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <span class="section-kicker section-kicker--light">
                <span class="material-symbols-outlined icon-size-sm">domain</span>
                <span class="eyebrow">The Office Problem</span>
            </span>
            <h2 class="section-heading">Your Team Is Trapped In <span class="section-heading__accent">Repetitive Work</span></h2>
            <p class="section-intro__description section-intro__description--wide">
                Every day, your human team loses hours of valuable time to simple office work. They get stuck sorting through papers, managing bills, and answering the same basic questions over and over again.
            </p>
        </div>

        <div class="feature-grid">
            <article class="trust-card-accent group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--accent">
                        <span class="material-symbols-outlined icon-tile__symbol icon-tile__symbol--accent">payments</span>
                    </div>
                    <h3 class="heading-medium heading-medium--accent">Wasted Funds</h3>
                </div>
                <p class="body-copy-small">
                    You are paying top dollar for smart people to do basic data entry.
                </p>
            </article>

            <article class="trust-card-accent group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--accent">
                        <span class="material-symbols-outlined icon-tile__symbol icon-tile__symbol--accent">trending_down</span>
                    </div>
                    <h3 class="heading-medium heading-medium--accent">Slow Growth</h3>
                </div>
                <p class="body-copy-small">
                    Your team is too busy dealing with old tasks to bring in new clients.
                </p>
            </article>

            <article class="trust-card-accent group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--accent">
                        <span class="material-symbols-outlined icon-tile__symbol icon-tile__symbol--accent">lock_open</span>
                    </div>
                    <h3 class="heading-medium heading-medium--accent">Data Privacy Risks</h3>
                </div>
                <p class="body-copy-small">
                    Employees often paste secret company info into public AI tools that are not safe.
                </p>
            </article>
        </div>
    </div>
</section>

<!-- Meet the Digital Employees Section -->
<section class="content-section content-section--light" id="digital-employees-showcase">
    <div class="section-container">
        <div class="employee-showcase">
            <div class="employee-showcase__layout">
                <div>
                    <span class="section-kicker section-kicker--light">
                        <span class="material-symbols-outlined icon-size-sm">badge</span>
                        <span class="eyebrow">Meet the Digital Employees</span>
                    </span>
                    <h2 class="section-heading">See how AI-powered employees<br><span>work alongside human employees</span></h2>
                    <p class="body-copy body-copy--relaxed employee-showcase__description">From customer support to compliance, our specialists are designed to take on repetitive operational work while humans stay in control of decisions, escalation, and accountability.</p>
                    <div class="employee-showcase__actions">
                        <a class="btn-primary" href="/digital-employees.html">Explore the Digital Employees</a>
                    </div>
                </div>

                <div class="employee-preview">
                    <div class="employee-preview__heading">
                        <img alt="Claire avatar" class="employee-preview__avatar" loading="lazy" decoding="async" src="/static/images/claire_agent_headshot.avif">
                        <div>
                            <h3 class="heading-medium">Claire</h3>
                            <p class="eyebrow eyebrow--primary">Customer Experience Agent</p>
                        </div>
                    </div>
                    <p class="body-copy-small body-copy-small--spaced">Claire helps teams manage incoming requests, triage work, and keep service moving without losing the human handoff.</p>
                    <div class="employee-preview__details">
                        <p class="employee-preview__details-title">What you'll discover</p>
                        <ul class="employee-preview__details-list">
                            <li>• How each digital employee is specialized for a specific workflow</li>
                            <li>• The human-supervised operating model behind the experience</li>
                            <li>• The security and policy guardrails that keep operations safe</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- The Tabiri Standard -->
<section class="content-section content-section--muted content-section--bordered" id="security-standards">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <span class="section-kicker section-kicker--light">
                <span class="material-symbols-outlined icon-size-sm">verified</span>
                <span class="eyebrow">The Tabiri Standard: Total Isolation</span>
            </span>
            <h2 class="section-heading">We Are A <span>Cybersecurity Company First</span></h2>
            <p class="section-intro__description section-intro__description--wide">
                We treat AI agents like malware and will never let your digital workers run loose on your network.
            </p>
        </div>

        <div class="feature-grid feature-grid--two-to-three">
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">shield</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Sovereign Node</span></h3>
                </div>
                <p class="body-copy-small">A private containment box that blocks all unauthorized data theft and cyber threats.</p>
            </article>

            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">no_accounts</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">No Data Training</span></h3>
                </div>
                <p class="body-copy-small">Your private data is never used to train public AI models. Absolute privacy.</p>
            </article>

            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">verified_user</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Human Control</span></h3>
                </div>
                <p class="body-copy-small">Strict safety guardrails. A human manager must click "approve" before finalization.</p>
            </article>                    
        </div>
    </div>
</section>

<!-- Choose Your Growth Path -->
<section class="content-section content-section--light" id="growth-path">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <span class="section-kicker">
                <span class="material-symbols-outlined icon-size-sm">trending_up</span>
                <span class="eyebrow">Choose Your Growth Path</span>
            </span>
            <h2 class="section-heading">Pick the Path That <span>Matches How You Grow</span></h2>
            <p class="section-intro__description section-intro__description--wide">
                Whether you need a custom internal team or a white-label partner model, Tabiri can adapt to your business motion.
            </p>
        </div>

        <div class="feature-grid feature-grid--two-at-large">
            <article class="trust-card group growth-card">
                <div class="card-heading-row growth-card__heading">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">business_center</span>
                    </div>
                    <div>
                        <h3 class="heading-medium">For Businesses</h3>
                        <p class="eyebrow eyebrow--primary">Entry point</p>
                    </div>
                </div>

                <p class="body-copy-small growth-card__description">
                    Want to get rid of your office backlogs and protect your private data with secure digital assistants? We design custom digital teammates for your specific ecosystem.
                </p>

                <a class="btn-primary growth-card__action" href="/contact">
                    Learn More About Our Digital Employees
                </a>
            </article>

            <article class="trust-card group growth-card">
                <div class="card-heading-row growth-card__heading">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">campaign</span>
                    </div>
                    <div>
                        <h3 class="heading-medium">For Marketing Agencies</h3>
                        <p class="eyebrow eyebrow--primary">White-label</p>
                    </div>
                </div>

                <p class="body-copy-small growth-card__description">
                    Want to stop selling basic marketing packages and start selling operational tech? White-label our platform wholesale to earn passive monthly revenue.
                </p>

                <a class="btn-secondary growth-card__action" href="/channel-partners">
                    Explore Our Wholesale Partner Program
                </a>
            </article>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="callout-section" id="sovereign-node-cta">
    <div class="callout">
        <div class="callout__overlay"></div>
        <div class="callout__content">
            <p class="callout__eyebrow">Build Your Sovereign Workforce</p>
            <h2 class="callout__heading callout__heading--nowrap">The <span>Sovereign Node</span> Awaits</h2>
            <p class="callout__description">
                Secure your data. Scale your team. Reclaim your focus. Deploy your first digital associate in as little as two weeks.
            </p>
            <div class="callout__actions">
                <a class="btn-primary" href="/contact">Get in Touch</a>
            </div>
        </div>
    </div>
</section>
{{end}}