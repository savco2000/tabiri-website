{{define "main"}}
<!-- Hero Section -->
<section class="page-hero" id="case-studies">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">verified</span>
            <span class="eyebrow">Validated Deployments</span>
        </div>
        <h1 class="hero-title">
            <span>Battle-Tested</span> Proof Across <span class="hero-title__accent">Complex Operations</span>
        </h1>
        <p class="hero-description">
            We do not just promise results. We apply secure AI and engineer-led cybersecurity to high-stakes,
            real-world operations under tight deadlines.
        </p>
        <div class="hero-actions">
            <a class="btn-primary" href="/contact">Schedule a Live Demonstration</a>
        </div>
    </div>
</section>

<!-- Case Studies Navigation Section -->
<nav class="case-study-nav" aria-label="Case studies">
    <div class="case-study-nav__content">
        <p class="case-study-nav__intro">Explore deployments</p>
        <div class="case-study-nav__links">
            <a class="case-study-nav__link" href="#regulated-fintech">
                <span>
                    <span class="case-study-nav__category">Financial services</span>
                    <span class="case-study-nav__title">Regulated FinTech</span>
                </span>
                <span class="material-symbols-outlined case-study-nav__arrow" aria-hidden="true">arrow_downward</span>
            </a>
            <a class="case-study-nav__link" href="#elijahs-bridge">
                <span>
                    <span class="case-study-nav__category">Legal operations</span>
                    <span class="case-study-nav__title">Elijah's Bridge</span>
                </span>
                <span class="material-symbols-outlined case-study-nav__arrow" aria-hidden="true">arrow_downward</span>
            </a>
            <a class="case-study-nav__link" href="#cdp-mapsync">
                <span>
                    <span class="case-study-nav__category">Municipal infrastructure</span>
                    <span class="case-study-nav__title">CDP-MapSync</span>
                </span>
                <span class="material-symbols-outlined case-study-nav__arrow" aria-hidden="true">arrow_downward</span>
            </a>
        </div>
    </div>
</nav>

<!-- Case Studies Section -->
<section class="content-section content-section--muted" id="featured-case-study">
    <div class="section-container">
        <!-- Regulated FinTech Case Study -->
        <article class="case-study case-study--reverse" id="regulated-fintech">
            <div class="case-study__visual case-study__visual--featured">
                <img alt="Secure digital payment processing for a regulated FinTech" class="case-study__image" width="1600" height="1067" loading="lazy" decoding="async" src="/static/images/fintech-compliance.avif">
                <div class="case-study__tint"></div>
                <div class="case-study__badges">
                    <span class="case-study__badge">Featured Mission</span>
                    <span class="case-study__badge case-study__badge--secondary">
                        <span class="material-symbols-outlined icon-size-sm">account_balance</span>
                        PCI DSS Mapped
                    </span>
                </div>
            </div>

            <div class="case-study__body">
                <p class="eyebrow eyebrow--accent eyebrow--compact">Regulated FinTech | Agentic SecOps</p>
                <h2 class="case-study__title">Hardening live payment infrastructure against AI-driven cyberthreats</h2>
                <p class="case-study__description">
                    Agentic SecOps helped Tabiri's engineers assess live payment infrastructure and deliver a prioritized resilience roadmap in 24 hours, up to 14× faster than a traditional manual penetration test.
                </p>
                <a class="text-link text-link--spaced" href="https://www.youtube.com/watch?v=iIEoY2s8uvE" target="_blank" rel="noopener noreferrer">
                    <span class="material-symbols-outlined icon-size-sm" aria-hidden="true">visibility</span>
                    Watch the Agentic SecOps product demo
                    <span class="material-symbols-outlined icon-size-sm" aria-hidden="true">arrow_forward</span>
                </a>

                <div class="case-study__metrics">
                    <div class="case-study-metrics">
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                            <span class="case-study-metrics__value">100%</span>
                            <span class="case-study-metrics__label">Internal TCP ports assessed</span>
                        </div>
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">shield_lock</span>
                            <span class="case-study-metrics__value">&lt;2 hrs</span>
                            <span class="case-study-metrics__label">To expose a critical risk</span>
                        </div>
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
                            <span class="case-study-metrics__value">30 Mins</span>
                            <span class="case-study-metrics__label">Mean Time To Detection (MTTD)</span>
                        </div>
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
                            <span class="case-study-metrics__value">14×</span>
                            <span class="case-study-metrics__label">Faster delivery than manual test</span>
                        </div>
                    </div>
                </div>

                <details class="case-study__details">
                    <summary>
                        View deployment details
                        <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                    </summary>
                    <div class="case-study-detail-list">
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined">shield_lock</span>
                            <p class="body-copy"><strong>Deeper attack-path visibility:</strong> Agentic SecOps correlated evidence across 31 service hostnames, every TCP port on the internal network, authenticated payment workflows and 26 governance domains, extending the assessment far beyond a surface scan.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined">speed</span>
                            <p class="body-copy"><strong>Immediate risk reduction:</strong> Within a couple of hours, Tabiri uncovered a critical cross-merchant authorization flaw, enabling the client to patch it immediately and our engineers to verify the fix the same day.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined">fact_check</span>
                            <p class="body-copy"><strong>Resilience against machine-speed attacks:</strong> The resulting roadmap strengthens endpoint detection and response, malware sandboxing, application allowlisting, threat intelligence, network segmentation, and weekly external scanning to reduce the paths AI-enabled malware can exploit.</p>
                        </div>
                    </div>
                </details>
            </div>
        </article>
        <!--Elijah's Bridge Case Study -->
        <article class="case-study case-study--following" id="elijahs-bridge">
            <div class="case-study__visual case-study__visual--centered">
                <img alt="Elijah's Bridge Legal Operating System" class="case-study__image case-study__image--contained" width="960" height="535" fetchpriority="high" decoding="async" src="/static/images/elijahs_bridge.avif">
                <div class="case-study__tint case-study__tint--subtle"></div>
            </div>

            <div class="case-study__body">
                <p class="eyebrow eyebrow--accent eyebrow--compact">Civil Rights | Legal Operations</p>
                <h2 class="case-study__title">Turning complex case records into a court-ready legal package</h2>
                <p class="case-study__description">
                    In a live deployment, Tabiri AI co-developed Elijah's Bridge, an attorney-supervised legal assistant built to help close the civil justice gap. Facing a tight federal court deadline, the system supported a self-represented litigant in an active civil-rights case and delivered a complete, court-ready draft package on time.
                </p>

                <div class="case-study__metrics">
                    <div class="case-study-metrics case-study-metrics--wide">
                        <div>
                            <span class="material-symbols-outlined" aria-hidden="true">description</span>
                            <span class="case-study-metrics__value">500+</span>
                            <span class="case-study-metrics__label">Documents organized</span>
                        </div>
                        <div>
                            <span class="material-symbols-outlined" aria-hidden="true">audio_file</span>
                            <span class="case-study-metrics__value">30+</span>
                            <span class="case-study-metrics__label">Recordings transcribed</span>
                        </div>
                        <div>
                            <span class="material-symbols-outlined" aria-hidden="true">image</span>
                            <span class="case-study-metrics__value">200+</span>
                            <span class="case-study-metrics__label">Images processed</span>
                        </div>
                        <div>
                            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                            <span class="case-study-metrics__value">100%</span>
                            <span class="case-study-metrics__label">Only approved databases cited</span>
                        </div>
                    </div>
                </div>

                <details class="case-study__details">
                    <summary>
                        View deployment details
                        <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                    </summary>
                    <div class="case-study-detail-list">
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">search_insights</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Precision Indexing:</strong> 500+ documents organized so every claim traces back to its exact source file.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">database</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Media Ingestion:</strong> Transcribed 250k+ characters from 30+ recordings into searchable evidence.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">gavel</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Authority Verification:</strong> Retrieved cited laws from approved databases with 100% accuracy.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">gpp_good</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Citation Guardrails:</strong> When intentionally asked to invent a supporting court case, the system refused to fabricate evidence.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Cross-Reference Validation:</strong> When given an inaccurate cross-reference claim, the system caught the error and refused to alter court papers.</p>
                        </div>
                    </div>
                </details>
            </div>
        </article>

        <!-- CDP-MapSync Case Study -->
        <article class="case-study case-study--reverse case-study--following" id="cdp-mapsync">
            <div class="case-study__visual case-study__visual--centered">
                <img alt="Continuous security monitoring across municipal data infrastructure" class="case-study__image" width="1600" height="1066" loading="lazy" decoding="async" src="/static/images/cdp-mapsync-monitoring.avif">
                <div class="case-study__logo-panel">
                    <img alt="CDP-MapSync" class="case-study__logo" width="880" height="185" loading="lazy" decoding="async" src="/static/images/cdp-mapsync-logo.png">
                </div>
            </div>

            <div class="case-study__body">
                <p class="eyebrow eyebrow--accent eyebrow--compact">Municipal Infrastructure | Continuous Monitoring</p>
                <h2 class="case-study__title">Evolving municipal geospatial security from alert queues to agentic defense</h2>
                <p class="case-study__description">
                    Tabiri partnered with CDP-MapSync to protect the internal and cloud systems behind GPS, GIS, and utility-infrastructure asset management. The relationship grew from a network-sensor pilot into ongoing endpoint monitoring, practical remediation, and a human-governed Agentic SecOps architecture.
                </p>

                <div class="case-study__metrics">
                    <div class="case-study-metrics">
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">history</span>
                            <span class="case-study-metrics__value">2019</span>
                            <span class="case-study-metrics__label">Initial monitoring pilot</span>
                        </div>
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">devices</span>
                            <span class="case-study-metrics__value">7</span>
                            <span class="case-study-metrics__label">Systems in expanded rollout</span>
                        </div>
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
                            <span class="case-study-metrics__value">30 Mins</span>
                            <span class="case-study-metrics__label">Mean Time To Detection (MTTD)</span>
                        </div>
                        <div class="case-study-metrics__item">
                            <span class="material-symbols-outlined" aria-hidden="true">sensors</span>
                            <span class="case-study-metrics__value">Ongoing</span>
                            <span class="case-study-metrics__label">Security monitoring</span>
                        </div>
                    </div>
                </div>

                <blockquote class="case-study__quote">
                    <p>“The continuous monitoring of our systems has been seamless with easy to interpret reporting.”</p>
                    <footer>David Carter, PE, LS, President, CDP-MapSync</footer>
                </blockquote>

                <details class="case-study__details case-study__details--spaced">
                    <summary>
                        View deployment details
                        <span class="material-symbols-outlined" aria-hidden="true">expand_more</span>
                    </summary>
                    <div class="case-study-detail-list">
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">travel_explore</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Continuous endpoint visibility:</strong> Lightweight agents forwarded system telemetry to Tabiri's cloud security stack, where indexing, analytics, and alert generation ran without placing the analysis burden on CDP-MapSync's systems.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">fact_check</span>
                            <p class="body-copy"><strong class="case-study-detail__label">Practical risk reduction:</strong> Engineers grouped findings by severity, identified high-severity software exposure, and maintained a remediation plan so CDP-MapSync could update affected systems quickly.</p>
                        </div>
                        <div class="case-study-detail">
                            <span class="material-symbols-outlined" aria-hidden="true">hub</span>
                            <p class="body-copy"><strong class="case-study-detail__label">A path to agentic defense:</strong> The evolved architecture delegates bounded health checks and alert investigations to endpoint agents while engineers retain control of scope, escalation, and potentially destructive response actions.</p>
                        </div>
                        <a class="text-link text-link--detail" href="/blog-post-3.html">Read the full monitoring story <span class="material-symbols-outlined icon-size-sm">arrow_forward</span></a>
                    </div>
                </details>
            </div>
        </article>
    </div>
</section>

<!-- CTA Section -->
