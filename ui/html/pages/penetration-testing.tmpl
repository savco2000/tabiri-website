{{define "main"}}
<!-- Hero Section -->
<section class="page-hero" id="penetration-testing-hero">
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">policy</span>
            <span class="eyebrow">Engineer-Led Offensive Security</span>
        </div>
        <h1 class="hero-title hero-title--wide">
            Find the Weaknesses <span>Before Attackers Do</span>
        </h1>
        <p class="hero-description">
            Uncover material risk before an audit, transaction, product launch, or attacker forces the issue. Our security engineers use configured agents to expand coverage and accelerate evidence collection, then personally validate every finding that reaches your team.
        </p>
        <div class="hero-actions">
            <a class="btn-primary" href="/contact">Scope a Penetration Test</a>
            <a class="btn-secondary" data-analytics-service-inquiry="rapid_exposure_triage" href="/rapid-exposure-triage">Discuss Rapid Exposure Triage</a>
        </div>
    </div>
</section>

<!-- Coverage -->
<section class="content-section content-section--muted content-section--border-bottom" id="assessment-coverage">
    <div class="section-container">
        <div class="section-intro">
            <p class="eyebrow eyebrow--accent">Assessment Coverage</p>
            <h2 class="section-heading">Test the Environment <span class="section-heading__accent">Attackers Actually See</span></h2>
            <p class="section-intro__description">We tailor each engagement to your systems, threat model, operating constraints, and compliance obligations.</p>
        </div>
        <div class="feature-grid">
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">public</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">External Assessment</span></h3>
                </div>
                <p class="body-copy-small">
                    Map internet-facing websites, APIs, mobile backends, services, and exposed network ports from an unauthenticated attacker's perspective.
                </p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">lan</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Internal Assessment</span></h3>
                </div>
                <p class="body-copy-small">
                    Assess in-scope internal systems through a controlled testing host, with access limited to the agreed environment and testing window.
                </p>                        
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">badge</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Authenticated Testing</span></h3>
                </div>
                <p class="body-copy-small">
                    Use approved test accounts and sandbox access to evaluate privilege boundaries, business workflows, integrations, and insider risk.
                </p>                       
            </article>
        </div>
        <div class="proof-card proof-card--muted proof-card--spaced">
            <div class="proof-card__feature">
                <div class="icon-tile proof-card__icon"><span class="material-symbols-outlined">verified_user</span></div>
                <div>
                    <p class="eyebrow eyebrow--accent eyebrow--compact">Defensive AI for an AI-Enabled Threat Landscape</p>
                    <h3 class="proof-card__heading proof-card__heading--compact"><span>Meet Machine-Speed Attacks with Machine-Speed Coverage</span></h3>
                    <p class="body-copy body-copy--relaxed body-copy--narrow">As offensive AI makes reconnaissance, attack adaptation, and repeated probing faster and less expensive, periodic manual testing alone becomes less representative of the pressure your environment faces. Agentic SecOps gives defenders comparable speed and scale while keeping scope, exploitation decisions, validation, and remediation guidance under experienced human control.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Customer Triggers -->
<section class="content-section content-section--light content-section--border-bottom" id="when-to-test">
    <div class="section-container">
        <div class="section-intro">
            <p class="eyebrow eyebrow--accent">When to Test</p>
            <h2 class="section-heading">Get Answers Before Risk Becomes <span>Your Next Constraint</span></h2>
            <p class="section-intro__description">A penetration test turns assumptions about your controls into evidence your technical, executive, and compliance teams can act on.</p>
        </div>
        <div class="feature-grid">
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">gavel</span></div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Prove Compliance</span></h3>
                </div>
                <p class="body-copy-small">Meet regulatory, PCI DSS, customer, cyber insurance, or board requirements with reproducible evidence and controls mapped to relevant obligations.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">rocket_launch</span></div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Change with Confidence</span></h3>
                </div>
                <p class="body-copy-small">Validate a new platform, integration, cloud migration, acquisition, or major release before expanded exposure turns an overlooked weakness into an incident.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary"><span class="material-symbols-outlined icon-tile__symbol">crisis_alert</span></div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Prioritize Real Risk</span></h3>
                </div>
                <p class="body-copy-small">Replace scanner noise and unresolved findings with verified attack paths, business impact, and a remediation plan your teams can defend and execute.</p>
            </article>
        </div>
    </div>
</section>

<!-- Methodology -->
<section class="content-section content-section--light" id="testing-methodology">
    <div class="method-layout">
        <div>
            <p class="eyebrow eyebrow--accent">Agentic SecOps Methodology</p>
            <h2 class="section-heading">Automation for Coverage. <span>Engineers for Judgment</span></h2>
            <p class="body-copy method-intro">Traditional tests can consume valuable expert time launching tools, normalizing output, deduplicating observations, and rebuilding context. Our configured agents handle that repeatable work continuously, while security engineers focus on attack hypotheses, business logic, safe execution, and whether a result is genuinely exploitable.</p>
            <div class="method-note">
                <div class="method-note__content">
                    <span class="material-symbols-outlined">verified_user</span>
                    <div>
                        <h3 class="heading-medium heading-medium--compact"><span class="heading-medium__highlight">Human Control on Production Systems</span></h3>
                        <p class="body-copy-small-compact">Testing windows, in-scope assets, source addresses, access methods, and potentially disruptive actions are coordinated with your team before execution.</p>
                    </div>
                </div>
            </div>
        </div>
        <ol class="process-steps">
            <li class="trust-card-no-hover process-step-card">
                <span class="process-step__number">01</span>
                <div><h3 class="heading-medium heading-medium--compact"><span class="heading-medium__highlight">Scope and Plan</span></h3><p class="body-copy-small-compact">Define assets, access, exclusions, testing windows, communication channels, and success criteria.</p></div>
            </li>
            <li class="trust-card-no-hover process-step-card">
                <span class="process-step__number">02</span>
                <div><h3 class="heading-medium heading-medium--compact"><span class="heading-medium__highlight">Discover and Test</span></h3><p class="body-copy-small-compact">Combine broad attack-surface discovery with targeted testing of applications, networks, identities, and integrations.</p></div>
            </li>
            <li class="trust-card-no-hover process-step-card">
                <span class="process-step__number">03</span>
                <div><h3 class="heading-medium heading-medium--compact"><span class="heading-medium__highlight">Validate and Prioritize</span></h3><p class="body-copy-small-compact">Manually verify exploitable findings, preserve reproducible evidence, and rank risk by likelihood and business impact.</p></div>
            </li>
            <li class="trust-card-no-hover process-step-card">
                <span class="process-step__number">04</span>
                <div><h3 class="heading-medium heading-medium--compact"><span class="heading-medium__highlight">Report and Remediate</span></h3><p class="body-copy-small-compact">Deliver an executive summary, technical evidence, practical remediation guidance, and a clear path to retesting.</p></div>
            </li>
        </ol>
    </div>
    <div class="proof-container">
        <div class="proof-card proof-card--muted">
            <div class="proof-card__content">
                <div>
                    <p class="eyebrow eyebrow--accent eyebrow--compact">Proven in a Live Payment Environment</p>
                    <h3 class="proof-card__heading proof-card__heading--compact"><span>Speed That Shortens Exposure</span></h3>
                    <p class="body-copy-small">For a regulated fintech, our team found a critical authorization flaw within two hours. The customer patched it and Tabiri verified the fix that same day.</p>
                </div>
                <div class="proof-card__metrics">
                    <div class="case-metric"><p class="case-metric__value">100%</p><p class="body-copy-small-compact">of in-scope internal TCP ports assessed</p></div>
                    <div class="case-metric"><p class="case-metric__value">24 hours</p><p class="body-copy-small-compact">to a prioritized resilience roadmap</p></div>
                    <div class="case-metric"><p class="case-metric__value">Up to 14x</p><p class="body-copy-small-compact">faster than the comparable manual process</p></div>
                </div>
            </div>
            <div class="proof-card__footer">
                <a class="text-link" href="/blog/inside-a-regulated-fintechs-agentic-secops-penetration-test">Read the penetration testing case study <span class="material-symbols-outlined icon-size-sm">arrow_forward</span></a>
            </div>
        </div>
    </div>
</section>

<!-- Deliverables -->
<section class="content-section content-section--muted content-section--bordered" id="penetration-test-deliverables">
    <div class="section-container">
        <div class="section-intro">
            <p class="eyebrow eyebrow--accent">Actionable Deliverables</p>
            <h2 class="section-heading">Evidence Your Teams Can Use</h2>
            <p class="section-intro__description">Give leaders, technical teams, and compliance stakeholders a shared view of the risk, the supporting evidence, and what to do next.</p>
        </div>
        <div class="feature-grid feature-grid--four">
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">summarize</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Executive Brief</span></h3>
                </div>
                <p class="body-copy-small">
                    Business impact, key risks, and prioritized next actions for leadership.
                </p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">fact_check</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Validated Findings</span></h3>
                </div>
                <p class="body-copy-small">
                    Severity, affected assets, reproduction evidence, and attack-path context.
                </p>
            </article>                   
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">handyman</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Remediation Plan</span></h3>
                </div>
                <p class="body-copy-small">
                    Specific, practical recommendations organized by urgency and effort.
                </p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">account_balance</span>
                    </div>
                    <h3 class="heading-medium"><span class="heading-medium__highlight">Compliance Mapping</span></h3>
                </div>
                <p class="body-copy-small">
                    Reporting aligned to applicable frameworks such as PCI DSS and sector guidance.
                </p>
            </article>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="callout-section callout-section--unbordered callout-section--white" id="penetration-testing-cta">
    <div class="callout">
        <div class="callout__overlay"></div>
        <div class="callout__content callout__content--narrow">
            <p class="callout__eyebrow">Know Where You Stand</p>
            <h2 class="callout__heading">Turn Unknown Risk into a <span>Clear Remediation Plan</span></h2>
            <p class="callout__description">Bring us your environment, deadline, and reporting obligations. We will define a controlled scope designed to surface material risk early without sacrificing human oversight.</p>
            <a class="btn-primary" href="/contact">Start the Conversation</a>
        </div>
    </div>
</section>
{{end}}