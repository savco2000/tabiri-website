{{define "main"}}
<!-- Hero Section -->
<section class="page-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">mail</span>
            <span class="eyebrow">Tabiri Newsletter</span>
        </div>
        <h1 class="hero-title">
            Practical ideas for leading <span>secure AI adoption</span>
        </h1>
        <p class="hero-description">
            Get thoughtful analysis on AI operations, governance, and digital workforce design delivered to your inbox.
        </p>
    </div>
</section>

<section class="newsletter-section" id="subscribe">
    <div class="newsletter-layout">
        <article class="trust-card newsletter-layout__form">
            {{if .FormSubmitted}}
            <div class="submission-success" id="newsletter-success" role="status">
                <div class="submission-success__summary">
                    <div class="icon-tile icon-tile--fixed icon-tile--success">
                        <span class="material-symbols-outlined">check_circle</span>
                    </div>
                    <div>
                        <h3 class="heading-compact">Thank you for subscribing</h3>
                        <p class="submission-success__message">You have successfully joined the Tabiri newsletter.</p>
                    </div>
                </div>
                <a class="btn-secondary submission-success__return" href="/">Return to Homepage</a>
            </div>
            {{else}}
            <div class="lead-form__heading lead-form__heading--spacious">
                <div class="icon-tile icon-tile--fixed">
                    <span class="material-symbols-outlined">mark_email_unread</span>
                </div>
                <div>
                    <h2 class="heading-compact">Subscribe to the Newsletter</h2>
                    <p class="body-copy-small-compact">Join leaders building useful AI without compromising trust.</p>
                </div>
            </div>

            <form action="/newsletter" class="lead-form" method="post">
                <input name="form_proof" type="hidden" value="{{.FormProof}}">
                <div aria-hidden="true" class="form-honeypot" hidden>
                    <label for="newsletter_website">Leave this field blank</label>
                    <input autocomplete="off" id="newsletter_website" name="website" tabindex="-1" type="text">
                </div>
                <div class="lead-form__field">
                    <label class="form-label" for="newsletter_first_name">First Name</label>
                    <input autocomplete="given-name" class="form-field-input" id="newsletter_first_name" maxlength="200" name="first_name" placeholder="Your first name" type="text" value="{{.NewsletterForm.FirstName}}">
                    {{with index .NewsletterForm.Errors "first_name"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                </div>

                <div class="lead-form__field">
                    <label class="form-label" for="newsletter_email">Email Address</label>
                    <input autocomplete="email" class="form-field-input" id="newsletter_email" maxlength="320" name="email" placeholder="you@company.com" required type="email" value="{{.NewsletterForm.Email}}">
                    {{with index .NewsletterForm.Errors "email"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                </div>

                <label class="lead-form__consent" for="newsletter_consent">
                    <input class="lead-form__checkbox" id="newsletter_consent" name="consent" required type="checkbox"{{if .NewsletterForm.Consent}} checked{{end}}>
                    <span>I agree to receive the Tabiri newsletter by email. I can unsubscribe at any time.</span>
                </label>
                {{with index .NewsletterForm.Errors "consent"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}

                <div class="lead-form__field">
                    <div class="cf-turnstile" data-action="newsletter_submit" data-sitekey="{{.TurnstileSiteKey}}" data-size="flexible"></div>
                    {{with index .NewsletterForm.Errors "verification"}}<p class="lead-form__error" role="alert">{{.}}</p>{{end}}
                </div>
                <button class="btn-primary lead-form__submit" type="submit">
                    <span class="material-symbols-outlined icon-size-sm lead-form__submit-icon">send</span>
                    Subscribe
                </button>
            </form>
            {{end}}
        </article>

        <aside class="newsletter-layout__benefits" aria-labelledby="newsletter-benefits-title">
            <p class="newsletter-benefits__eyebrow">In Every Edition</p>
            <h2 class="newsletter-benefits__heading" id="newsletter-benefits-title">Signal, without the noise</h2>
            <div class="newsletter-benefits__list">
                <div class="newsletter-benefits__item">
                    <div class="icon-tile icon-tile--fixed">
                        <span class="material-symbols-outlined">strategy</span>
                    </div>
                    <div>
                        <h3>Practical Playbooks</h3>
                        <p class="body-copy-small-compact">Clear guidance for introducing AI into real operating environments.</p>
                    </div>
                </div>
                <div class="newsletter-benefits__item">
                    <div class="icon-tile icon-tile--fixed">
                        <span class="material-symbols-outlined">shield_lock</span>
                    </div>
                    <div>
                        <h3>Security Perspective</h3>
                        <p class="body-copy-small-compact">Governance and data protection considerations explained plainly.</p>
                    </div>
                </div>
                <div class="newsletter-benefits__item">
                    <div class="icon-tile icon-tile--fixed">
                        <span class="material-symbols-outlined">schedule</span>
                    </div>
                    <div>
                        <h3>Respect for Your Time</h3>
                        <p class="body-copy-small-compact">Concise, useful editions sent only when there is something worth sharing.</p>
                    </div>
                </div>
            </div>
            <a class="newsletter-benefits__back" href="/blog">
                <span class="material-symbols-outlined icon-size-sm">arrow_back</span>
                Return to the blog
            </a>
        </aside>
    </div>
</section>
{{end}}