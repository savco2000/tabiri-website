{{define "main"}}
<!-- Hero Section -->
<section class="page-hero" id="channel-partner-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content--centered">
        <div class="hero-kicker">
            <span class="material-symbols-outlined icon-size-sm">handshake</span>
            <span class="eyebrow">Channel Partner Program 2026</span>
        </div>
        <h1 class="partner-hero__title">
            Stop Just Generating Leads. <span>Become Your Clients' Operating System</span>
        </h1>
        <p class="partner-hero__description">
            White-label Tabiri AI's secure digital workforce to eliminate your clients' back-office bottlenecks and unlock high-margin recurring monthly revenue.
        </p>
        <a class="btn-primary" href="/partner-contact">Apply To Join The Wholesale Pilot Program</a>
    </div>
</section>

<!-- Agency Revenue Bottleneck Section -->
<section class="content-section content-section--muted content-section--bordered" id="agency-revenue-bottleneck">
    <div class="section-container">
        <div class="section-intro">
            <h2 class="section-heading section-heading--unspaced"><span class="section-heading__accent">The Marketing Agency Trap</span></h2>
            <p class="body-copy body-copy--relaxed partner-section__description">
                Revenue growth is limited by client bandwidth. Leads get delivered, but administrative teams get overwhelmed, creating a ceiling for your agency's scale.
            </p>
        </div>

        <div class="partner-bottleneck">
            <figure class="partner-bottleneck__image">
                <img alt="Strong marketing lead flow narrowing through overloaded client operations and resulting in delayed conversion and revenue leakage" width="1536" height="1024" loading="lazy" decoding="async" src="/static/images/agency-revenue-bottleneck.avif">
            </figure>

            <div class="process-steps">
                <article class="trust-card-accent group">
                    <div class="card-heading-row">
                        <div class="icon-tile icon-tile--inline icon-tile--error">
                            <span class="material-symbols-outlined icon-tile__symbol--error">trending_down</span>
                        </div>
                        <h3 class="heading-medium heading-medium--accent">Dropped Revenue</h3>
                    </div>
                    <p class="body-copy-small-compact">Slow intake teams fail to follow up on the high-quality leads you provide.</p>
                </article>
                <article class="trust-card-accent group">
                    <div class="card-heading-row">
                        <div class="icon-tile icon-tile--inline icon-tile--error">
                            <span class="material-symbols-outlined icon-tile__symbol--error">timer</span>
                        </div>
                        <h3 class="heading-medium heading-medium--accent">Wasted Hours</h3>
                    </div>
                    <p class="body-copy-small-compact">Skilled professionals spend valuable time on manual paperwork and entry-level tasks.</p>
                </article>
                <article class="trust-card-accent group">
                    <div class="card-heading-row">
                        <div class="icon-tile icon-tile--inline icon-tile--error">
                            <span class="material-symbols-outlined icon-tile__symbol--error">sync_disabled</span>
                        </div>
                        <h3 class="heading-medium heading-medium--accent">Contract Churn</h3>
                    </div>
                    <p class="body-copy-small-compact">Back-office bottlenecks lead to paused marketing spend when clients cannot handle the growth.</p>
                </article>
            </div>
        </div>
    </div>
</section>

<!-- Agency Offerings Section -->
<section class="content-section content-section--light content-section--border-top" id="what_your_agency_can_offer">
    <div class="section-container">
        <div class="section-intro">
            <h3 class="section-heading section-heading--unspaced">What Your Agency  <span>Can Offer Your Existing Clients</span></h3>
            <p class="body-copy body-copy--relaxed">
            Tabiri AI is an invisible provider. Agencies white-label the platform, selling operational technology directly to their clients without the need to hire developers or AI engineers.
        </p>
        </div>
        <div class="feature-grid feature-grid--four">
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">person_add</span>
                    </div>
                    <h4 class="heading-medium"><span class="heading-medium__highlight">Automated Client Intake</span></h4>
                </div>
                <p class="body-copy-small-compact">Greeting prospects and building case files automatically 24/7.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">task_alt</span>
                    </div>
                    <h4 class="heading-medium"><span class="heading-medium__highlight">Back-Office Task Execution</span></h4>
                </div>
                <p class="body-copy-small-compact">Handling organization, billing, and payments with digital precision.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">shield_lock</span>
                    </div>
                    <h4 class="heading-medium"><span class="heading-medium__highlight">Private Data Security</span></h4>
                </div>
                <p class="body-copy-small-compact">Completely isolated Sovereign Nodes ensuring client data sovereignty.</p>
            </article>
            <article class="trust-card group">
                <div class="card-heading-row">
                    <div class="icon-tile icon-tile--inline icon-tile--primary">
                        <span class="material-symbols-outlined icon-tile__symbol">security</span>
                    </div>
                    <h4 class="heading-medium"><span class="heading-medium__highlight">Active Threat Protection</span></h4>
                </div>
                <p class="body-copy-small-compact">Built-in monitoring to protect client infrastructure from emerging threats.</p>
            </article>
        </div>
    </div>
</section>

<!-- Wholesale Economics Section -->
<section class="content-section content-section--muted content-section--bordered">
    <div class="section-container">
        <div class="section-intro section-intro--spacious">
            <h2 class="section-heading">Simple Wholesale Economics</h2>
            <p class="body-copy">High-margin arbitrage through infrastructure ownership.</p>
        </div>

        <div class="partner-economics">
            <article class="trust-card-no-hover partner-economics__summary">
                <div class="partner-economics__header">
                    <h3 class="heading-medium">Profit Summary</h3>
                    <span class="partner-economics__label">Agency Projections</span>
                </div>
                <div class="profit-table__viewport">
                    <table class="profit-table">
                        <thead>
                            <tr>
                                <th>Revenue Stream</th>
                                <th>Details</th>
                                <th>Profit Potential</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Wholesale Cost</td>
                                <td>$1,500 / month per node</td>
                                <td class="profit-table__amount--muted">--</td>
                            </tr>
                            <tr>
                                <td>Target Retail</td>
                                <td>$2,500 - $4,000 / month</td>
                                <td class="profit-table__amount--muted">--</td>
                            </tr>
                            <tr>
                                <td>Net Recurring Profit</td>
                                <td>Per account</td>
                                <td>$1,000 - $2,500 / mo</td>
                            </tr>
                            <tr>
                                <td>Implementation Fees</td>
                                <td>Upfront setup</td>
                                <td>$5,000 - $15,000</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="partner-economics__scaling">
                    <span class="heading-medium">Scaling Math</span>
                    <span class="heading-medium heading-medium--primary">50 clients = $125,000 MRR</span>
                </div>
            </article>

            <article class="partner-pilot">
                <div class="partner-pilot__content">
                    <h3 class="partner-pilot__heading">Pilot Network Availability</h3>
                    <p class="partner-pilot__description">We are accepting 4-5 regional agencies for the exclusive wholesale network.</p>
                    <div class="process-steps">
                        <div class="partner-pilot__status">
                            <span class="partner-pilot__status-label">Active Slots</span>
                            <span class="partner-pilot__status-value">4 / 5 Remaining</span>
                        </div>
                        <div class="partner-pilot__progress">
                            <div class="partner-pilot__progress-fill"></div>
                        </div>
                    </div>
                    <div class="partner-pilot__notice">
                        <span class="material-symbols-outlined">info</span>
                        <span class="partner-pilot__notice-text">Regional exclusivity. Applications reviewed weekly.</span>
                    </div>
                </div>
                <div class="partner-pilot__decoration">
                    <span class="material-symbols-outlined">hub</span>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="callout-section" id="partner-network-cta">
    <div class="callout">
        <div class="callout__overlay"></div>
        <div class="callout__content">
            <p class="callout__eyebrow">Turn Client Demand Into Recurring Revenue</p>
            <h2 class="callout__heading callout__heading--nowrap">Ready to Join the <span>Channel Partner Network?</h2>
            <p class="callout__description">
                Submit your partner application to start a fit assessment and explore regional rollout opportunities with the Tabiri platform.
            </p>
            <div class="callout__actions">
                <a class="btn-primary" href="/partner-contact">Apply as a Channel Partner</a>
            </div>
        </div>
    </div>
</section>
{{end}}