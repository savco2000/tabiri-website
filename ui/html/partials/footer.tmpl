{{define "footer"}}
<footer class="site-footer" id="site-footer">
    <div class="site-footer__columns">
        <div class="site-footer__brand">
            <div class="site-footer__logo">
                <img alt="Tabiri logo" class="site-footer__logo-image" width="161" height="77" loading="lazy" decoding="async" src="/static/svg/logo.svg">
            </div>
            <p class="site-footer__description">
                Empowering the modern enterprise with secure, agentic intelligence. Sovereign by design.
            </p>
        </div>
        <div id="footer-product-links">
            <h3 class="site-footer__heading">PRODUCT</h3>
            <ul class="site-footer__links">
                <li><a class="footer-link" href="/case-studies">Case Studies</a></li>
                <li><a class="footer-link" href="/data-protection">Sovereign Node</a></li>
                <li><a class="footer-link" href="/managed-cybersecurity-services">CyberSecurity</a></li>                   
            </ul>
        </div>
        <div id="footer-company-links">
            <h3 class="site-footer__heading">COMPANY</h3>
            <ul class="site-footer__links">
                <li><a class="footer-link" href="/about">About Us</a></li>
                <li><a class="footer-link" href="/channel-partners">Partners</a></li>
                <li><a class="footer-link" href="/contact">Contact</a></li>
            </ul>
        </div>
        <div>
            <h3 class="site-footer__heading">LEGAL</h3>
            <ul class="site-footer__links">
                <li><a class="footer-link" href="/privacy-policy">Privacy Policy <span class="site-footer__draft">(draft)</span></a></li>
                <li><a class="footer-link" href="/terms-of-service">Terms of Service <span class="site-footer__draft">(draft)</span></a></li>
                <li><a class="footer-link" href="/security-disclosure">Security Disclosure <span class="site-footer__draft">(draft)</span></a></li>
            </ul>
        </div>
    </div>
    <div class="site-footer__bottom">
        <span>© {{.CurrentYear}} Tabiri Analytics. Lexington, KY, USA.</span>
        <div class="site-footer__settings">
            <button class="footer-link site-footer__settings-button" id="cookie-settings" type="button">Cookie settings</button>
        </div>
    </div>
</footer>
{{end}}