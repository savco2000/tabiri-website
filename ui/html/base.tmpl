{{define "base"}}
<!DOCTYPE html>
<html class="scroll-smooth" lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="{{.PageDescription}}">
    {{if .CanonicalURL}}<link rel="canonical" href="{{.CanonicalURL}}">{{end}}
    <meta property="og:title" content="{{.PageTitle}}">
    <meta property="og:description" content="{{.OpenGraphDescription}}">
    <meta property="og:type" content="website">
    {{if .CanonicalURL}}<meta property="og:url" content="{{.CanonicalURL}}">{{end}}
    {{if .OpenGraphImage}}<meta property="og:image" content="{{.OpenGraphImage}}">{{end}}
    <meta name="twitter:card" content="{{if .OpenGraphImage}}summary_large_image{{else}}summary{{end}}">
    <meta name="twitter:title" content="{{.PageTitle}}">
    <meta name="twitter:description" content="{{.OpenGraphDescription}}">
    {{if .OpenGraphImage}}<meta name="twitter:image" content="{{.OpenGraphImage}}">{{end}}
    <title>{{.PageTitle}}</title>
    <link rel="icon" href="/static/favicon.ico" sizes="any">
    <link rel="preload" href="/static/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/static/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/static/fonts/material-symbols-outlined.woff2" as="font" type="font/woff2" crossorigin>
    <link href="/static/css/fonts.css?v=2" rel="stylesheet">
    <link href="/static/css/styles.css" rel="stylesheet">
</head>
<body class="bg-surface text-on-surface font-body selection:bg-primary-container selection:text-white">
    {{template "nav" .}}

    <main class="pt-24 md:pt-28" id="index-main">
        {{template "main" .}}        
    </main>

    {{template "footer" .}}    

    <section
        id="analytics-consent"
        class="fixed inset-x-4 bottom-4 z-[100] mx-auto max-w-3xl rounded-xl border border-outline-variant bg-surface-container-lowest p-5 shadow-2xl md:inset-x-6 md:bottom-6"
        role="region"
        aria-label="Analytics preferences"
        aria-live="polite"
        hidden>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="max-w-xl">
                <h2 class="font-headline text-headline-sm text-on-background">Your privacy choices</h2>
                <p class="mt-2 text-body-sm text-on-surface-variant">
                    With your permission, we use Google Tag Manager for analytics. You can accept or reject analytics, and change your choice at any time. Read our <a class="text-primary underline" href="/privacy-policy">draft Privacy Policy</a>.
                </p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-3">
                <button class="btn-secondary" id="reject-analytics" type="button">Reject analytics</button>
                <button class="btn-primary" id="accept-analytics" type="button">Accept analytics</button>
            </div>
        </div>
    </section>

    <!-- Scroll Up Button -->
    <button 
        id="scrollUpBtn" 
        class="fixed bottom-6 right-6 z-50 hidden translate-y-4 opacity-0 rounded-full bg-blue-600 p-3 text-white shadow-lg transition-all duration-300 hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-300"
        aria-label="Go to top">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
        </svg>
    </button>

    <script src="/static/js/mobile-nav.js"></script>
    <script src="/static/js/scroll-up.js"></script>
    <script src="/static/js/dropdown-nav.js"></script>
    <script src="/static/js/automation-funnel.js"></script>
    <script src="/static/js/analytics.js"></script>
    {{if .TurnstileSiteKey}}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{{end}}
</body>
</html>
{{end}}