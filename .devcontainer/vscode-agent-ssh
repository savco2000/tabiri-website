#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${SSH_AUTH_SOCK:-}" && -S "$SSH_AUTH_SOCK" ]] &&
  SSH_AUTH_SOCK="$SSH_AUTH_SOCK" ssh-add -l >/dev/null 2>&1; then
  exec /usr/bin/ssh "$@"
fi

shopt -s nullglob

for socket in /tmp/vscode-ssh-auth-*.sock; do
  [[ -S "$socket" && -O "$socket" ]] || continue

  if SSH_AUTH_SOCK="$socket" ssh-add -l >/dev/null 2>&1; then
    export SSH_AUTH_SOCK="$socket"
    exec /usr/bin/ssh "$@"
  fi
done

echo "No usable VS Code SSH agent socket was found" >&2
exit 255
