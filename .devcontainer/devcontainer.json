{
  "name": "Go HTMX Tailwind",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
	      "ms-azuretools.vscode-docker",
	      "ms-vscode-remote.remote-containers",
        "golang.go",
        "bradlc.vscode-tailwindcss",
        "satrik.tailwind-highlight",
        "qwtel.sqlite-viewer",
	      "ms-vscode.makefile-tools"
      ]
    }
  },
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Tabiri website",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "git config --global core.sshCommand /usr/local/bin/vscode-agent-ssh && git config --local user.name \"Savannah O. Kadima\" && git config --local user.email \"savannah.kadima@tabirianalytics.com\" && go mod download && npm ci"
}